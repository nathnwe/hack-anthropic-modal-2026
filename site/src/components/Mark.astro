---
// Rewire Bio mark: two strands that cross and swap sides — a rewired connection.
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: cls = '' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  class={cls}
  aria-hidden="true"
>
  <!-- left strand crossing to the right -->
  <path
    d="M9 4v7c0 3 14 7 14 10v7"
    stroke="currentColor"
    stroke-width="2.4"
    stroke-linecap="round"
  />
  <!-- right strand crossing to the left, broken at the junction for depth -->
  <path
    d="M23 4v7c0 1.6-3.9 3.4-7.4 5.2"
    stroke="currentColor"
    stroke-width="2.4"
    stroke-linecap="round"
  />
  <path
    d="M12.6 18.3C10.6 19.6 9 21 9 22.4V28"
    stroke="currentColor"
    stroke-width="2.4"
    stroke-linecap="round"
  />
</svg>
