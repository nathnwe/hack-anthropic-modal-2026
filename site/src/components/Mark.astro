---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<!-- TAD mark: a chromatin loop rising from the DNA baseline, with a nested sub-domain -->
<svg class={className} viewBox="0 0 96 96" fill="none" aria-hidden="true">
  <path
    d="M14 82H28C32 82 34 76 34 72C14 62 14 16 48 16S82 62 62 72C62 76 64 82 68 82H82"
    stroke="currentColor"
    stroke-width="7"
    stroke-linecap="round"
  />
  <path
    d="M34 72C28 60 32 40 48 40S68 60 62 72"
    stroke="var(--accent, #52683f)"
    stroke-width="6"
    stroke-linecap="round"
  />
</svg>
