---
import { strategies } from "../data/strategies";
---

<section id="methods" class="results-section methods-section">
  <div class="section-heading">
    <h2>Stapling strategies</h2>
    <span class="small muted">7 approaches</span>
  </div>
  <p class="section-description">
    Method-level evidence; not validated for this target. Select a strategy to
    compare tradeoffs.
  </p>
  <div class="strategy-list">
    {strategies.map((s, i) => (
      <details class="strategy" name="stapling-strategy">
        <summary>
          <span class="mono strategy-index">
            {String(i + 1).padStart(2, "0")}
          </span>
          <strong>{s.name}</strong>
          <span class="strategy-mechanism">{s.mechanism}</span>
          <span class="expand-icon" aria-hidden="true">
            +
          </span>
        </summary>
        <div class="strategy-detail">
          <dl>
            <div>
              <dt>Mammalian evidence</dt>
              <dd>{s.evidence}</dd>
            </div>
            <div>
              <dt>Switchability</dt>
              <dd>{s.switchability}</dd>
            </div>
            <div>
              <dt>Main attraction</dt>
              <dd>{s.attraction}</dd>
            </div>
            <div>
              <dt>Main issue</dt>
              <dd>{s.issue}</dd>
            </div>
          </dl>
          <a
            class="source-link"
            href={s.source}
            target="_blank"
            rel="noopener noreferrer"
          >
            {s.citation} ↗
          </a>
        </div>
      </details>
    ))}
  </div>
</section>
