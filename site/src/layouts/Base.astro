---
import '../styles/global.css';

interface Props {
  title: string;
  /** Landing page shows in-page section anchors; other pages do not. */
  landing?: boolean;
}

const { title, landing = false } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(/\/$/, '');
---

<!doctype html>
<html lang="en" class="h-full scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title}</title>
  </head>
  <body class="min-h-full bg-slate-950 text-slate-200 antialiased">
    <nav class="sticky top-0 z-40 border-b border-slate-800/80 bg-slate-950/85 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center gap-6 px-4 py-3.5 sm:px-6">
        <a href={`${base}/`} class="flex shrink-0 items-center gap-2.5">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M4 3v14M16 3v14" stroke="#38bdf8" stroke-width="2" stroke-linecap="round" />
            <path d="M4 7c6 0 6 6 12 6" stroke="#d95926" stroke-width="2" stroke-linecap="round" />
          </svg>
          <span class="text-[15px] font-semibold tracking-tight text-white">Rewire Bio</span>
        </a>

        <div class="ml-auto flex items-center gap-5 text-sm">
          {
            landing && (
              <>
                <a href="#about" class="hidden text-slate-400 transition hover:text-white sm:block">About</a>
                <a href="#team" class="hidden text-slate-400 transition hover:text-white sm:block">Team</a>
                <a href="#contact" class="hidden text-slate-400 transition hover:text-white sm:block">Contact</a>
              </>
            )
          }
          <a
            href={`${base}/api`}
            class:list={[
              'transition hover:text-white',
              path === `${base}/api` ? 'text-sky-400' : 'text-slate-400',
            ]}
          >
            API
          </a>
          <a
            href={`${base}/workbench`}
            class="rounded-md bg-sky-500 px-3.5 py-1.5 text-sm font-medium text-slate-950 transition hover:bg-sky-400"
          >
            Workbench
          </a>
        </div>
      </div>
    </nav>

    <slot />

    <footer class="border-t border-slate-800/80 py-8">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 text-xs text-slate-600 sm:px-6">
        <p>Rewire Bio — 3D genome engineering, target shortlisting.</p>
        <p>In silico predictions, not experimentally validated.</p>
      </div>
    </footer>
  </body>
</html>
