---
import '../styles/global.css';
import Mark from '../components/Mark.astro';

interface Props {
  title: string;
  /** Landing shows section anchors and a nav that fades in past the hero. */
  landing?: boolean;
}

const { title, landing = false } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title}</title>
  </head>
  <body class="bg-parchment text-ink">
    <nav
      id="site-nav"
      class="fixed inset-x-0 top-0 z-50 transition-[background-color,backdrop-filter] duration-500"
    >
      <div class="mx-auto flex max-w-6xl items-center px-6 py-5 sm:px-10">
        <a href={`${base}/`} class="flex items-center gap-2.5 text-ink">
          <Mark size={22} />
          <span class="text-[15px] font-medium tracking-tight">Rewire Bio</span>
        </a>

        <div class="ml-auto flex items-center gap-7 text-[13px]">
          {
            landing && (
              <>
                <a href="#about" class="hidden text-ink/55 transition-colors hover:text-ink sm:block">About</a>
                <a href="#team" class="hidden text-ink/55 transition-colors hover:text-ink sm:block">Team</a>
                <a href="#contact" class="hidden text-ink/55 transition-colors hover:text-ink sm:block">Contact</a>
              </>
            )
          }
          <a
            href={`${base}/api`}
            class:list={[
              'transition-colors hover:text-ink',
              path === `${base}/api` ? 'text-ink' : 'text-ink/55',
            ]}
          >
            API
          </a>
          <a
            href={`${base}/workbench`}
            class:list={[
              'transition-colors hover:text-ink',
              path === `${base}/workbench` || path === `${base}/results` ? 'text-ink' : 'text-ink/55',
            ]}
          >
            Workbench
          </a>
        </div>
      </div>
    </nav>

    <main class={landing ? '' : 'pt-20'}>
      <slot />
    </main>

    <footer class="mx-auto max-w-6xl px-6 pb-14 pt-20 sm:px-10">
      <div class="flex flex-wrap items-center justify-between gap-y-2 text-[12px] text-ink/40">
        <p>Rewire Bio — 3D genome engineering</p>
        <p>In silico predictions, not experimentally validated</p>
      </div>
    </footer>

    <script is:inline>
      // Reveal on enter. One observer for the whole document.
      (function () {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let pending = Array.from(document.querySelectorAll('.reveal'));

        if (reduce) {
          pending.forEach((el) => el.classList.add('in'));
        } else {
          // Reveal anything that has reached the viewport *or* that the reader has
          // already scrolled past — an anchor jump skips over sections, and those
          // must not be left permanently invisible.
          const sweep = () => {
            if (!pending.length) return;
            const limit = window.innerHeight * 0.92;
            pending = pending.filter((el) => {
              if (el.getBoundingClientRect().top < limit) {
                el.classList.add('in');
                return false;
              }
              return true;
            });
          };

          let ticking = false;
          const onScroll = () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(() => {
              sweep();
              ticking = false;
            });
          };

          sweep();
          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('resize', onScroll, { passive: true });
        }

        // The bar is always present; it only gains a surface once content slides
        // underneath it.
        const nav = document.getElementById('site-nav');
        if (nav) {
          const onScroll = () => {
            const lifted = window.scrollY > 24;
            nav.style.backdropFilter = lifted ? 'blur(10px)' : '';
            nav.style.background = lifted
              ? 'color-mix(in srgb, #f2eedf 86%, transparent)'
              : '';
          };
          onScroll();
          window.addEventListener('scroll', onScroll, { passive: true });
        }
      })();
    </script>
  </body>
</html>
