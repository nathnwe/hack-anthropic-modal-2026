---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;

// BASE_URL carries a trailing slash in some Astro configs; normalise once so
// every link in the site is built the same way.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(/\/$/, '');

const nav = [
  { href: `${base}/`, label: 'Genes', match: base },
  { href: `${base}/search`, label: 'Search', match: `${base}/search` },
];
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title}</title>
  </head>
  <body class="min-h-full bg-slate-950 text-slate-200 antialiased">
    <nav class="border-b border-slate-800/80 bg-slate-950/80 backdrop-blur">
      <div class="mx-auto flex max-w-5xl items-center gap-6 px-4 py-3 sm:px-6">
        <a href={`${base}/`} class="flex items-center gap-2 text-sm font-semibold text-white">
          <span class="inline-block h-2.5 w-2.5 rounded-full bg-sky-500"></span>
          Chromatin stapling
        </a>
        <div class="flex items-center gap-4 text-sm">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'transition hover:text-slate-200',
                  path === item.match ? 'font-medium text-sky-400' : 'text-slate-500',
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </div>
    </nav>

    <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
      <slot />
    </div>
  </body>
</html>
