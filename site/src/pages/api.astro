---
import Layout from "../layouts/Layout.astro";
import type { GeneRecord } from "../lib/records";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const files = Object.entries(
  import.meta.glob<GeneRecord>("../../public/data/*.json", {
    eager: true,
    import: "default",
  }),
);
const example = `const response = await fetch('${base}/data/runx1.json');
if (!response.ok) throw new Error('Record unavailable');
const record = await response.json();

// Preserve this flag in any downstream interface.
if (record.illustrative === true) {
  console.info('Placeholder data — not a finding');
}

// These are precomputed model results, not live inference.
const designs = record.analysis.designs.filter(d =>
  d.status === 'shortlisted' && d.risk.tier !== 'BLOCKED'
);
console.log(record.gene.symbol, designs);
// delta_target is regulatory-input change, not expression.`;
---

<Layout title="Data API — Rewire Bio" page="api">
  <div class="page-shell api-shell">
    <div class="api-intro">
      <p class="eyebrow">Data API</p>
      <h1>
        Records &amp;
        <br /> provenance.
      </h1>
      <p class="lead">
        One gene and direction. One JSON file.
        <br />
        Every field available to inspect.
      </p>
      <p>
        These are precomputed static records served with the site. No API key,
        server-side computation or live prediction is involved.
      </p>
      <p>
        LDLR, NSD1, RUNX1, NF1, MECP2 and MYC have K562 pipeline analyses using
        measured Hi-C at 5 kb resolution. MECP2 includes both directions; MYC
        includes downregulation. All simulations are experimentally unvalidated.
      </p>
      <p>
        Live gene search separately uses{" "}
        <a href="https://mygene.info/">MyGene.info</a>
        and <a href="https://rest.ensembl.org/">Ensembl</a> for human reference
        annotations. A reference lookup does not generate regulatory
        predictions.
      </p>
      <a
        class="text-link"
        href="https://github.com/nathnwe/hack-anthropic-modal-2026/blob/main/contracts/schema.json"
        target="_blank"
        rel="noopener noreferrer"
      >
        Read the data contract ↗
      </a>
    </div>
    <div class="api-content">
      <section>
        <p class="eyebrow">01 / Request</p>
        <div class="endpoint">
          <span class="tag">GET</span>
          <code>{base}/data/&lt;gene&gt;.json</code>
        </div>
        <p>
          Use the lowercase filename listed below. Unknown filenames return a
          404; there is no fallback prediction.
        </p>
        <p>
          The MYC sample in the workbench uses{" "}
          <a href={`${base}/data/case-studies/myc-k562.json`}>myc-k562.json</a>:
          all 56 K562 CSV rows, source accessions, conditions, scores and a
          sourced reference TSS. This case-study dataset is separate from the
          pipeline contract below; it supplies no TAD, measured contacts or
          staple predictions.
        </p>
        <div class="data-files">
          {files.map(([path, r]) => (
            <a href={`${base}/data/${path.split("/").pop()}`}>
              <span class="mono">{path.split("/").pop()}</span>
              <span class="tag">
                {r.illustrative
                  ? "Placeholder"
                  : r.analysis
                    ? "K562 analysis"
                    : "Record"}
              </span>
              <span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </section>
      <section>
        <p class="eyebrow">02 / Read a record</p>
        <pre><code>{example}</code></pre>
        <p class="placeholder-note">
          <span aria-hidden="true">◇</span>
          <span>
            <strong>Preserve data status.</strong> The MYC, SHANK3 and PMP22
            fixture records have <code>illustrative: true</code>. Their
            annotations, coordinates and scores are placeholders.
          </span>
        </p>
      </section>
      <section>
        <p class="eyebrow">03 / Response structure</p>
        <dl class="schema-fields">
          <div>
            <dt>gene</dt>
            <dd>
              Symbol, chromosome, TSS, disease annotation, dosage direction and
              source strings.
            </dd>
          </div>
          <div>
            <dt>locus</dt>
            <dd>
              Cell type and genomic scope. In these pipeline exports,
              <code>scope_kind: analysis_window</code> identifies the 2 Mb
              interval stored in the legacy <code>tad</code> field. No TAD was
              called. The <code>cres</code> and <code>contacts</code> arrays are
              empty: rE2G scores and contact matrices were not exported.
            </dd>
          </div>
          <div>
            <dt>staples</dt>
            <dd>
              Candidate anchor pairs, requested mode and a qualitative predicted
              change.
            </dd>
          </div>
          <div>
            <dt>risks</dt>
            <dd>
              Flags attached to shortlisted staple IDs. LOW maps to low and
              ELEVATED to medium. CLEAR has no flags; its distinct meaning is
              preserved in <code>analysis</code>. BLOCKED designs are excluded
              from <code>staples</code> and retained as rejected analyses.
            </dd>
          </div>
          <div>
            <dt>ranking</dt>
            <dd>
              The legacy contract permits composite scores and A/B/C tiers.
              Pipeline exports leave this array empty because the run supplies
              neither those scores nor a method recommendation.
            </dd>
          </div>
          <div>
            <dt>analysis</dt>
            <dd>
              Versioned extension permitted by the existing schema. Contains
              original ranks, confidence labels, risk gates, 5 kb element and
              anchor bins, contact-strength sweeps and unmodified source output.
              Quantitative ΔT/T describes regulatory input only. The source file
              hash, GRCh38 reference annotation and coordinate convention are
              included.
            </dd>
          </div>
        </dl>
        <p class="small muted">
          No shared-schema change is required. Consumers of the legacy fields
          should inspect <code>analysis</code> before interpreting these
          records. An empty array indicates unavailable metrics, not a
          biological zero.
        </p>
      </section>
    </div>
  </div>
</Layout>
