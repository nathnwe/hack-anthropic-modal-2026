---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const records = Object.values(
  import.meta.glob('../../public/data/*.json', { eager: true, import: 'default' })
) as any[];
const symbols = records.map((r) => r.gene.symbol).sort();
---

<Base title="API — Rewire Bio">
  <div class="mx-auto max-w-2xl px-6 py-20 sm:px-10">
    <p class="reveal text-[11px] font-medium uppercase tracking-[0.2em] text-clay">API</p>
    <h1 class="reveal reveal-delay-1 mt-5 text-[32px] font-medium leading-[1.2] tracking-[-0.025em]">
      Data access
    </h1>
    <p class="reveal reveal-delay-2 mt-5 text-[16px] leading-[1.75] text-ink/55">
      Every gene record is a static JSON file validated against the project's data
      contract. There is no server and no key — fetch the file.
    </p>
    <p class="reveal reveal-delay-3 mt-5 text-[15px] leading-[1.75] text-ink/45">
      This build serves fixtures. Records carrying
      <code class="font-mono text-[13px] text-clay">"illustrative": true</code> are
      placeholders, not real coordinates or scores.
    </p>

    <section class="reveal mt-16">
      <h2 class="text-[11px] font-medium uppercase tracking-[0.2em] text-ink/40">Endpoint</h2>
      <p class="mt-5 font-mono text-[15px] text-clay">GET /data/&lt;gene&gt;.json</p>
      <p class="mt-2 text-[15px] leading-relaxed text-ink/55">
        One gene record: gene, locus, staples, risks, ranking.
      </p>
    </section>

    <section class="reveal mt-16">
      <h2 class="text-[11px] font-medium uppercase tracking-[0.2em] text-ink/40">
        Available genes
      </h2>
      <div class="mt-5 flex flex-wrap gap-x-7 gap-y-2.5">
        {
          symbols.map((s) => (
            <a
              href={`${base}/data/${s.toLowerCase()}.json`}
              class="font-mono text-[14px] text-ink/55 transition-colors hover:text-clay"
            >
              {s.toLowerCase()}.json
            </a>
          ))
        }
      </div>
    </section>

    <section class="reveal mt-16">
      <h2 class="text-[11px] font-medium uppercase tracking-[0.2em] text-ink/40">Example</h2>
      <pre class="hairline mt-5 overflow-x-auto border-l pl-5 font-mono text-[13px] leading-[1.9] text-ink/70"><code>{`const res = await fetch('${base}/data/myc.json');
const record = await res.json();

record.gene.symbol;      // "MYC"
record.gene.direction;   // "too_much" | "too_little"
record.locus.cres;       // elements with rE2G scores
record.locus.contacts;   // modelled promoter contacts
record.staples;          // candidate anchor pairs
record.risks;            // per-staple flags
record.ranking;          // score, tier, rationale, method`}</code></pre>
    </section>

    <section class="reveal mt-16">
      <h2 class="text-[11px] font-medium uppercase tracking-[0.2em] text-ink/40">Schema</h2>
      <p class="mt-5 text-[15px] leading-relaxed text-ink/55">
        The authoritative definition lives in
        <a
          href="https://github.com/nathnwe/hack-anthropic-modal-2026/blob/main/contracts/schema.json"
          class="text-clay underline underline-offset-2 transition-colors hover:text-ink"
          target="_blank"
          rel="noopener">contracts/schema.json</a
        >, validated in CI on every change.
      </p>
    </section>
  </div>
</Base>
