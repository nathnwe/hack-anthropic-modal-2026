---
import Base from '../layouts/Base.astro';

// Gene records live in public/data/ and conform to contracts/schema.json.
// Reading them at build time keeps the deployed site fully static.
const records = Object.values(
  import.meta.glob('../../public/data/*.json', { eager: true, import: 'default' })
) as any[];

const genes = records.sort((a, b) => a.gene.symbol.localeCompare(b.gene.symbol));
const anyIllustrative = genes.some((g) => g.illustrative);

const directionLabel = {
  too_much: 'too much',
  too_little: 'too little',
};
---

<Base title="3D Genome Engineering — target shortlisting">
  <header class="border-b border-slate-800 pb-8">
    <p class="text-xs font-semibold uppercase tracking-widest text-sky-400">
      Chromatin stapling
    </p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
      Target shortlisting for 3D genome engineering
    </h1>
    <p class="mt-4 max-w-3xl text-slate-400">
      Given a dosage-sensitive gene and a cell type, this tool proposes which two genomic
      regions to staple, predicts the direction of effect, flags secondary risks, and ranks
      the options.
    </p>
  </header>

  {
    anyIllustrative && (
      <div class="mt-8 rounded-lg border border-amber-500/40 bg-amber-500/10 p-4">
        <p class="text-sm font-semibold text-amber-300">Illustrative data</p>
        <p class="mt-1 text-sm text-amber-200/80">
          Some records below are placeholders, not real coordinates or scores. They are
          here to prove the data contract renders, and must not be read as findings.
        </p>
      </div>
    )
  }

  <section class="mt-10">
    <h2 class="text-sm font-semibold uppercase tracking-widest text-slate-500">
      Candidate genes ({genes.length})
    </h2>

    <ul class="mt-4 space-y-3">
      {
        genes.map((record) => (
          <li class="rounded-lg border border-slate-800 bg-slate-900/50 p-5">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="font-mono text-lg font-semibold text-white">
                {record.gene.symbol}
              </h3>
              <p class="font-mono text-xs text-slate-500">
                chr{record.gene.chrom}:{record.gene.tss.toLocaleString()}
              </p>
            </div>
            <p class="mt-2 text-sm text-slate-400">{record.gene.disease}</p>
            <div class="mt-3 flex flex-wrap items-center gap-2 text-xs">
              <span class="rounded-full border border-slate-700 px-2 py-0.5 text-slate-300">
                {directionLabel[record.gene.direction]}
              </span>
              <span class="text-slate-600">
                {record.staples.length} candidate{record.staples.length === 1 ? '' : 's'}
              </span>
              {record.illustrative && (
                <span class="rounded-full bg-amber-500/15 px-2 py-0.5 font-medium text-amber-300">
                  illustrative
                </span>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <footer class="mt-14 border-t border-slate-800 pt-6 text-xs text-slate-500">
    <p>
      Predictions are in silico and not experimentally validated. Built on UniversalEPI
      (Grover et al., 2026) and ENCODE-rE2G (Gschwind et al., 2026).
    </p>
  </footer>
</Base>
