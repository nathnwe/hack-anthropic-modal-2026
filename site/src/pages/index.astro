---
import Base from '../layouts/Base.astro';
import LoopPanel from '../components/LoopPanel.astro';
import Molecule from '../components/Molecule.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const steps = [
  ['Name a gene', 'A dosage-sensitive gene driving a disease, and the direction of change you want.'],
  ['Map the neighbourhood', 'We resolve the TAD, the regulatory elements inside it, and which ones actually contact the promoter.'],
  ['Rank the options', 'Candidate staples are scored and tiered, with secondary risks surfaced rather than buried.'],
  ['Choose a method', 'A stapling strategy matched to the locus, the cell type, and whether you need it reversible.'],
];

// Names and affiliation as supplied by the team; roles follow docs/plan.md.
const team = [
  ['Leandre Tappenden', 'University of Oxford', 'Interface — workbench and visualisation'],
  ['Nathan Ewer', 'University of Oxford', 'Pipeline — loci, contacts, candidate staples'],
  ['Christopher Paton', 'University of Oxford', 'Scoring — targets, risk and ranking'],
];
---

<Base title="Rewire Bio" landing={true}>
  <!-- ───────────────────────── Hero ───────────────────────── -->
  <section class="px-6 pb-24 pt-44 sm:px-10 sm:pb-32 sm:pt-52">
    <div class="mx-auto grid max-w-[1400px] gap-x-20 gap-y-10 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)]">
      <h1 class="reveal text-[42px] font-semibold leading-[1.03] tracking-[-0.035em] sm:text-[64px] lg:text-[76px]">
        Rewiring gene dosage without rewriting the genome
      </h1>
      <div class="reveal reveal-delay-2 lg:pt-5">
        <p class="max-w-md text-[17px] leading-[1.7] text-ink/65">
          Cells already control genes by folding DNA so that distant regulatory
          elements touch the right promoters. Rewire Bio finds which contact to alter
          for a given disease gene — and says how confident it is.
        </p>
        <a
          href={`${base}/workbench`}
          class="group mt-8 inline-flex items-center gap-2.5 text-[16px] text-clay transition-colors hover:text-ink"
        >
          Open the Workbench
          <span class="transition-transform group-hover:translate-x-1">→</span>
        </a>
      </div>
    </div>
  </section>

  <LoopPanel />

  <!-- ──────────────── Strand canvas ──────────────── -->
  <div id="strand-canvas" class="relative mt-28">
    <Molecule />

    <!-- Below lg the strand stays on a left rail, so content is padded clear of it.
         At lg it weaves between rails and the sections sit opposite each turn. -->
    <div class="mx-auto max-w-[1400px] pb-36 pl-[76px] pr-6 sm:pl-[84px] sm:pr-10 lg:px-10">
      <!-- helix runs left here, so content sits right -->
      <section data-section data-side="left" id="about" class="scroll-mt-28 py-24 sm:py-32">
        <div class="ml-auto max-w-2xl lg:w-[64%]">
          <div class="flex items-baseline gap-5">
            <span class="font-mono text-[12px] tabular-nums text-ink/30">01</span>
            <p class="text-[11px] font-medium uppercase tracking-[0.2em] text-clay">About</p>
          </div>
          <h2 class="reveal mt-7 text-[28px] font-medium leading-[1.22] tracking-[-0.025em] sm:text-[36px]">
            A design system for 3D genome engineering
          </h2>
          <div class="reveal reveal-delay-1 mt-8 space-y-5 text-[16px] leading-[1.75] text-ink/60">
            <p>
              Many disease genes are hard to drug directly. Gene and epigenetic
              therapies usually rewrite sequence or add new regulatory instructions,
              which carries off-target risk and a long regulatory road.
            </p>
            <p>
              Three-dimensional organisation is a quieter lever. Bringing an enhancer
              into contact with a promoter — or breaking that contact — changes
              expression using machinery the cell already runs, and it is reversible.
            </p>
          </div>

          <ol class="mt-14 grid gap-x-12 gap-y-9 sm:grid-cols-2">
            {
              steps.map(([title, body], i) => (
                <li class:list={['reveal', `reveal-delay-${Math.min(i + 1, 3)}`]}>
                  <h3 class="text-[16px] font-medium tracking-[-0.01em]">
                    <span class="mr-2.5 font-mono text-[12px] text-ink/30">0{i + 1}</span>
                    {title}
                  </h3>
                  <p class="mt-2 text-[15px] leading-[1.7] text-ink/55">{body}</p>
                </li>
              ))
            }
          </ol>

          <p class="reveal mt-16 text-[19px] leading-[1.6] tracking-[-0.01em] text-ink/75 sm:text-[21px]">
            Every prediction here is in silico and unvalidated. Effect sizes are the
            weakest link, so we report ordinal tiers rather than numbers that imply
            precision — and show the risks a staple creates alongside the benefit it
            promises.
          </p>
        </div>
      </section>

      <!-- helix crosses to the right, so content sits left -->
      <section data-section data-side="right" id="team" class="scroll-mt-28 py-24 sm:py-32">
        <div class="mr-auto max-w-2xl lg:w-[64%]">
          <div class="flex items-baseline gap-5">
            <span class="font-mono text-[12px] tabular-nums text-ink/30">02</span>
            <p class="text-[11px] font-medium uppercase tracking-[0.2em] text-clay">Team</p>
          </div>
          <h2 class="reveal mt-7 text-[28px] font-medium leading-[1.22] tracking-[-0.025em] sm:text-[36px]">
            Built at Anthropic × Modal 2026
          </h2>
          <ul class="mt-12">
            {
              team.map(([name, org, role], i) => (
                <li
                  class:list={[
                    'reveal',
                    `reveal-delay-${Math.min(i + 1, 3)}`,
                    'grid gap-x-10 gap-y-1 py-7 sm:grid-cols-[minmax(0,14rem)_minmax(0,1fr)]',
                    i > 0 ? 'hairline border-t' : '',
                  ]}
                >
                  <div>
                    <p class="text-[17px] font-medium tracking-[-0.01em]">{name}</p>
                    <p class="mt-0.5 text-[13px] text-ink/40">{org}</p>
                  </div>
                  <p class="text-[15px] leading-[1.7] text-ink/55 sm:pt-0.5">{role}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section data-section data-side="left" id="contact" class="scroll-mt-28 py-24 sm:py-32">
        <div class="ml-auto max-w-2xl lg:w-[64%]">
          <div class="flex items-baseline gap-5">
            <span class="font-mono text-[12px] tabular-nums text-ink/30">03</span>
            <p class="text-[11px] font-medium uppercase tracking-[0.2em] text-clay">Contact</p>
          </div>
          <h2 class="reveal mt-7 text-[28px] font-medium leading-[1.22] tracking-[-0.025em] sm:text-[36px]">
            Talk to us
          </h2>
          <p class="reveal reveal-delay-1 mt-7 text-[16px] leading-[1.75] text-ink/60">
            We are looking for collaborators with locus-level experimental capacity. The
            predictions here need testing before they mean anything.
          </p>
          <div class="reveal reveal-delay-2 mt-10 flex flex-wrap items-center gap-x-10 gap-y-3 text-[15px]">
            <a
              href={`${base}/workbench`}
              class="group inline-flex items-center gap-2 text-clay transition-colors hover:text-ink"
            >
              Open the Workbench
              <span class="transition-transform group-hover:translate-x-1">→</span>
            </a>
            <a
              href="https://github.com/nathnwe/hack-anthropic-modal-2026"
              class="text-ink/50 transition-colors hover:text-ink"
              target="_blank"
              rel="noopener"
            >
              GitHub
            </a>
          </div>
        </div>
      </section>
    </div>
  </div>

</Base>
