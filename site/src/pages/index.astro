---
import Layout from "../layouts/Layout.astro";
import Mark from "../components/Mark.astro";
import Thread from "../components/Thread.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout title="Rewire Bio — A new connection" page="home">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-topline eyebrow">
      <span class="status-dot"></span> Exploring the architecture of expression
    </div>
    <div class="hero-lockup">
      <Mark class="hero-mark" />
      <h1 id="hero-title">
        Rewire Bio<span>.</span>
      </h1>
    </div>
    <p class="hero-description">
      The next possibility is already in the genome.
      <br />
      Let’s find the connection.
    </p>
    <a class="button dark" href={`${base}/workbench/`}>
      Explore the workbench <span aria-hidden="true">↗</span>
    </a>
    <div class="hero-bottom">
      <span class="mono">3D GENOME ENGINEERING</span>
      <a href="#about">
        A different perspective <span aria-hidden="true">↓</span>
      </a>
      <span class="mono">ANTHROPIC × MODAL ’26</span>
    </div>
  </section>
  <div class="story">
    <Thread />
    <section id="about" class="story-section about-section">
      <p class="eyebrow section-kicker">01 / The idea</p>
      <div class="story-copy">
        <h2>
          Same genome.
          <br />
          <em>New connections.</em>
        </h2>
        <p class="lead">
          What if we could change how a gene is regulated by changing what it
          connects to?
        </p>
        <p>
          Rewire Bio explores an approach to gene regulation through the
          genome’s three-dimensional architecture. Our ambition is to bring
          existing regulatory elements into useful new relationships with a
          gene.
        </p>
        <p>
          Start with a target. Explore its neighbourhood. Find a connection
          worth investigating.
        </p>
        <a class="text-link" href={`${base}/workbench/`}>
          See the idea in practice <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
    <section class="story-section approach-section">
      <p class="eyebrow section-kicker">02 / The workbench</p>
      <div class="story-copy">
        <h2>
          From a question
          <br />
          to a <em>shortlist.</em>
        </h2>
        <ol class="approach-list">
          <li>
            <span class="mono">01</span>
            <div>
              <h3>Choose a direction.</h3>
              <p>
                Name a target gene and the change in expression you want to
                explore.
              </p>
            </div>
          </li>
          <li>
            <span class="mono">02</span>
            <div>
              <h3>Read the neighbourhood.</h3>
              <p>
                Explore regulatory elements and promoter contacts within its
                topological domain.
              </p>
            </div>
          </li>
          <li>
            <span class="mono">03</span>
            <div>
              <h3>Inspect the possibilities.</h3>
              <p>
                Compare candidate anchor pairs, reported tiers, risk flags and
                potential stapling methods.
              </p>
            </div>
          </li>
        </ol>
        <p class="research-note">
          <span class="status-dot"></span> A research prototype. Current
          examples use labelled placeholder data. In silico predictions need
          experimental validation.
        </p>
      </div>
    </section>
    <section id="team" class="story-section team-section">
      <p class="eyebrow section-kicker">03 / The people</p>
      <div class="story-copy">
        <h2>
          Different disciplines.
          <br />
          <em>Shared curiosity.</em>
        </h2>
        <p class="lead">
          Built at the intersection of regulatory biology, computation and
          design.
        </p>
        <p>
          A project for the Anthropic × Modal 2026 hackathon. Our work brings
          together genomic mapping, transparent ranking and an interface for
          asking better questions.
        </p>
        <div class="team-roles">
          <span>Genomics & pipeline</span>
          <span>Scoring & science</span>
          <span>Interface & visualisation</span>
        </div>
        <p class="small muted">
          Team member details will be added before launch.
        </p>
      </div>
    </section>
    <section id="contact" class="story-section contact-section">
      <p class="eyebrow section-kicker">04 / Keep exploring</p>
      <div class="story-copy">
        <h2>
          Good science starts
          <br />
          with a <em>connection.</em>
        </h2>
        <p class="lead">
          Explore the prototype, inspect the data, or join the conversation
          around the project.
        </p>
        <div class="contact-actions">
          <a class="button dark" href={`${base}/workbench/`}>
            Open workbench <span aria-hidden="true">↗</span>
          </a>
          <a
            class="text-link"
            href="https://github.com/nathnwe/hack-anthropic-modal-2026"
            target="_blank"
            rel="noopener noreferrer"
          >
            Find us on GitHub ↗
          </a>
        </div>
      </div>
    </section>
  </div>
  <script>
    const story = document.querySelector<HTMLElement>(".story");
    const thread = document.querySelector<SVGPathElement>(".thread-progress");
    const media = matchMedia("(prefers-reduced-motion: reduce)");
    let scheduled = false;
    function draw() {
      scheduled = false;
      if (!story || !thread) return;
      const rect = story.getBoundingClientRect();
      const progress = media.matches
        ? 1
        : Math.max(
            0,
            Math.min(1, (innerHeight * 0.65 - rect.top) / rect.height),
          );
      thread.style.strokeDashoffset = String(1 - progress);
    }
    function queueDraw() {
      if (!scheduled) {
        scheduled = true;
        requestAnimationFrame(draw);
      }
    }
    addEventListener("scroll", queueDraw, { passive: true });
    addEventListener("resize", queueDraw);
    media.addEventListener("change", queueDraw);
    draw();
  </script>
</Layout>
