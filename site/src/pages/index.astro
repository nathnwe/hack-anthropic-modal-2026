---
import Layout from "../layouts/Layout.astro";
import Mark from "../components/Mark.astro";
import LoopPanel from "../components/LoopPanel.astro";
import Thread from "../components/Thread.astro";
import { team } from "../data/team";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout
  title="Rewire Bio — 3D genome engineering"
  description="A research workbench for prioritising regulatory contacts and candidate interventions in 3D genome engineering."
  page="home"
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-topline eyebrow">
      <span class="status-dot"></span> Exploring the architecture of expression
    </div>
    <div class="hero-lockup">
      <Mark class="hero-mark" />
      <h1 id="hero-title">
        Rewire Bio<span>.</span>
      </h1>
    </div>
    <p class="hero-description">
      The next possibility is already in the genome.
      <br />
      Let’s find the connection.
    </p>
    <a class="button dark" href={`${base}/workbench/`}>
      Explore the workbench <span aria-hidden="true">↗</span>
    </a>
    <div class="hero-bottom">
      <span class="mono">3D GENOME ENGINEERING</span>
      <a href="#loop-film">
        A different perspective <span aria-hidden="true">↓</span>
      </a>
      <span class="mono">ANTHROPIC × MODAL ’26</span>
    </div>
  </section>
  <LoopPanel />
  <div class="story">
    <Thread />
    <section
      id="about"
      class="story-section science-section"
      aria-labelledby="about-title"
    >
      <p class="eyebrow section-kicker">01 / About</p>
      <div class="science-copy">
        <div class="landing-reveal">
          <h2 id="about-title">A design system for 3D genome engineering</h2>
          <p>
            For dosage-sensitive genes, the amount of gene product matters.
            Rewire Bio is a research workbench for identifying regulatory
            contacts that could be altered to increase or decrease a target
            gene’s expression.
          </p>
          <p>
            Enhancers regulate transcription through interactions with gene
            promoters. Programmable DNA tethering can bring selected genomic
            regions together without cutting the DNA sequence. The effect on
            expression, and whether it is reversible, depend on the locus, cell
            type and tethering method.
          </p>
          <p class="science-source">
            Experimental precedent:{" "}
            <a
              href="https://www.nature.com/articles/ncomms15993"
              target="_blank"
              rel="noopener noreferrer"
            >
              inducible chromatin looping · Morgan et al., 2017{" "}
              <span aria-hidden="true">↗</span>
            </a>
          </p>
        </div>
        <ol class="science-steps">
          <li class="landing-reveal">
            <h3>
              <span class="mono">01</span> Name a gene
            </h3>
            <p>
              A dosage-sensitive target and the desired direction of expression
              change.
            </p>
          </li>
          <li class="landing-reveal reveal-delay-1">
            <h3>
              <span class="mono">02</span> Map the neighbourhood
            </h3>
            <p>
              Inspect regulatory elements, available TAD boundaries and evidence
              of contacts with the promoter.
            </p>
          </li>
          <li class="landing-reveal">
            <h3>
              <span class="mono">03</span> Rank candidate contacts
            </h3>
            <p>
              Compare proposed anchor pairs, evidence tiers and potential
              effects on other genes.
            </p>
          </li>
          <li class="landing-reveal reveal-delay-1">
            <h3>
              <span class="mono">04</span> Choose a method
            </h3>
            <p>
              Compare DNA stapling strategies by experimental evidence,
              reversibility and practical constraints.
            </p>
          </li>
        </ol>
        <p class="research-note landing-reveal">
          Research prototype. Predicted effects are unvalidated; tiers indicate
          relative evidence, not probabilities. Illustrative records are
          labelled.
        </p>
      </div>
    </section>
    <section
      id="team"
      class="story-section team-section"
      aria-labelledby="team-title"
    >
      <p class="eyebrow section-kicker">02 / Team</p>
      <div class="team-content">
        <div class="story-copy landing-reveal">
          <h2 id="team-title">The team.</h2>
          <p>Built for the Anthropic × Modal 2026 hackathon.</p>
        </div>
        <div class="team-grid">
          {team.map((person, index) => (
            <article
              class:list={[
                "team-profile",
                "landing-reveal",
                `reveal-delay-${index + 1}`,
              ]}
              aria-labelledby={`team-${person.id}`}
            >
              <div class="team-portrait">
                <img
                  src={`${base}/images/team/${person.id}.webp`}
                  alt={person.name}
                  width={person.imageSize}
                  height={person.imageSize}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <p class="team-role">{person.role}</p>
              <h3 id={`team-${person.id}`}>{person.name}</h3>
              <p class="team-bio">{person.bio}</p>
              <a
                class="team-link"
                href={person.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${person.name} on LinkedIn`}
              >
                LinkedIn <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
    <section
      id="contact"
      class="story-section contact-section"
      aria-labelledby="contact-title"
    >
      <p class="eyebrow section-kicker">03 / Contact</p>
      <div class="story-copy landing-reveal">
        <h2 id="contact-title">
          Discuss the
          <br />
          <em>research.</em>
        </h2>
        <p>
          Interested in testing a locus or contributing data? Contact the team
          through the profiles above, or open an issue on GitHub.
        </p>
        <div class="contact-actions">
          <a
            class="button dark"
            href="https://github.com/nathnwe/hack-anthropic-modal-2026/issues"
            target="_blank"
            rel="noopener noreferrer"
          >
            Get in touch <span aria-hidden="true">↗</span>
          </a>
          <a
            class="text-link"
            href="https://github.com/nathnwe/hack-anthropic-modal-2026"
            target="_blank"
            rel="noopener noreferrer"
          >
            View the code <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>
  </div>
  <script>
    import "../scripts/landing";
  </script>
</Layout>
