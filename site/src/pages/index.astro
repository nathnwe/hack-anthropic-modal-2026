---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Team roster. Names/roles are placeholders for the team to fill in — no real
// people are asserted here.
const team = [
  { initials: 'A', name: 'Operator A', role: 'Pipeline — loci, contacts, candidate staples' },
  { initials: 'B', name: 'Operator B', role: 'Scoring — targets, risk, ranking' },
  { initials: 'C', name: 'Operator C', role: 'Interface — workbench, visualisation' },
];

const steps = [
  {
    n: '01',
    title: 'Name a gene',
    body: 'A dosage-sensitive gene driving a disease, and whether it needs turning up or down.',
  },
  {
    n: '02',
    title: 'Map the neighbourhood',
    body: 'We resolve the TAD, the regulatory elements inside it, and which ones actually contact the promoter.',
  },
  {
    n: '03',
    title: 'Rank the options',
    body: 'Candidate staples are scored and tiered, with secondary risks surfaced rather than buried.',
  },
  {
    n: '04',
    title: 'Choose a method',
    body: 'A stapling strategy matched to the locus, the cell type, and whether you need it reversible.',
  },
];
---

<Base title="Rewire Bio — 3D genome engineering" landing={true}>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-slate-800/80">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.07]"
      style="background-image:radial-gradient(circle at 20% 20%, #38bdf8 0, transparent 45%), radial-gradient(circle at 80% 30%, #d95926 0, transparent 40%)"
    >
    </div>

    <div class="relative mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-400">
        Reversible gene dosage control
      </p>
      <h1 class="mt-5 max-w-3xl text-4xl font-semibold leading-[1.1] tracking-tight text-white sm:text-6xl">
        Change what a gene does
        <span class="block text-slate-500">without changing its sequence.</span>
      </h1>
      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-slate-400">
        Cells already control genes by folding DNA so that distant regulatory elements
        touch the right promoters. Rewire Bio finds which contact to alter for a given
        disease gene — and tells you how confident it is.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a
          href={`${base}/workbench`}
          class="rounded-md bg-sky-500 px-5 py-2.5 text-sm font-medium text-slate-950 transition hover:bg-sky-400"
        >
          Open the Workbench
        </a>
        <a
          href="#about"
          class="rounded-md border border-slate-700 px-5 py-2.5 text-sm font-medium text-slate-300 transition hover:border-slate-600 hover:text-white"
        >
          How it works
        </a>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="scroll-mt-16 border-b border-slate-800/80">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">About</p>
      <h2 class="mt-4 max-w-2xl text-2xl font-semibold tracking-tight text-white sm:text-3xl">
        A design system for 3D genome engineering
      </h2>

      <div class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
        <div class="space-y-4 text-slate-400">
          <p>
            Many disease genes are hard to drug directly. Gene and epigenetic therapies
            usually rewrite sequence or add new regulatory instructions, which carries
            off-target risk and a long regulatory road.
          </p>
          <p>
            Three-dimensional organisation is a quieter lever. Bringing an enhancer into
            contact with a promoter — or breaking that contact — changes expression using
            machinery the cell already runs, and it is reversible.
          </p>
          <p>
            The data exists. What has been missing is a way to turn it into a decision:
            <span class="text-slate-300">
              for this gene, in this cell type, which contact should we alter, and what
              should we expect?
            </span>
          </p>
        </div>

        <ol class="space-y-5">
          {
            steps.map((s) => (
              <li class="flex gap-4 rounded-lg border border-slate-800 bg-slate-900/40 p-4">
                <span class="font-mono text-xs font-semibold text-sky-400">{s.n}</span>
                <div>
                  <h3 class="text-sm font-semibold text-white">{s.title}</h3>
                  <p class="mt-1 text-sm text-slate-500">{s.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="mt-10 rounded-lg border border-amber-500/30 bg-amber-500/[0.07] p-5">
        <h3 class="text-sm font-semibold text-amber-300">What we don't know</h3>
        <p class="mt-1.5 max-w-3xl text-sm text-amber-100/70">
          Every prediction here is in silico and unvalidated. Effect sizes are the weakest
          link, so we report ordinal tiers rather than numbers that imply precision, and we
          show the risks a staple creates alongside the benefit it promises.
        </p>
      </div>
    </div>
  </section>

  <!-- Team -->
  <section id="team" class="scroll-mt-16 border-b border-slate-800/80">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Team</p>
      <h2 class="mt-4 text-2xl font-semibold tracking-tight text-white sm:text-3xl">
        Built at Anthropic × Modal 2026
      </h2>

      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {
          team.map((m) => (
            <div class="rounded-lg border border-slate-800 bg-slate-900/40 p-5">
              <div class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-700 bg-slate-800 font-mono text-sm font-semibold text-sky-400">
                {m.initials}
              </div>
              <h3 class="mt-4 text-sm font-semibold text-white">{m.name}</h3>
              <p class="mt-1 text-sm text-slate-500">{m.role}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-4 text-xs text-slate-600">Replace with real names and roles before submission.</p>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="scroll-mt-16">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Contact</p>
      <h2 class="mt-4 text-2xl font-semibold tracking-tight text-white sm:text-3xl">
        Talk to us
      </h2>
      <p class="mt-3 max-w-xl text-slate-400">
        We are looking for collaborators with locus-level experimental capacity — the
        predictions here need testing before they mean anything.
      </p>

      <div class="mt-7 flex flex-wrap gap-3">
        <a
          href="https://github.com/nathnwe/hack-anthropic-modal-2026"
          class="rounded-md border border-slate-700 px-4 py-2.5 text-sm text-slate-300 transition hover:border-slate-600 hover:text-white"
        >
          GitHub repository
        </a>
        <a
          href={`${base}/workbench`}
          class="rounded-md bg-sky-500 px-4 py-2.5 text-sm font-medium text-slate-950 transition hover:bg-sky-400"
        >
          Try the Workbench
        </a>
      </div>
    </div>
  </section>
</Base>
