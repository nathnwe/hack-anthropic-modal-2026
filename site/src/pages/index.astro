---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const steps = [
  ['Name a gene', 'A dosage-sensitive gene driving a disease, and the direction of change you want.'],
  ['Map the neighbourhood', 'We resolve the TAD, the regulatory elements inside it, and which ones actually contact the promoter.'],
  ['Rank the options', 'Candidate staples are scored and tiered, with secondary risks surfaced rather than buried.'],
  ['Choose a method', 'A stapling strategy matched to the locus, the cell type, and whether you need it reversible.'],
];

// Names and affiliation as given by the team. Roles follow the project split in
// docs/plan.md — confirm before submission.
const team = [
  ['Leandre Tappenden', 'University of Oxford', 'Interface — workbench and visualisation'],
  ['Nathan Ewer', 'University of Oxford', 'Pipeline — loci, contacts, candidate staples'],
  ['Christopher Paton', 'University of Oxford', 'Scoring — targets, risk and ranking'],
];
---

<Base title="Rewire Bio" landing={true}>
  <!-- ───────────────────────── Hero ───────────────────────── -->
  <section class="mx-auto max-w-6xl px-6 pb-28 pt-40 sm:px-10 sm:pb-40 sm:pt-52">
    <div class="grid gap-x-16 gap-y-10 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)]">
      <h1 class="reveal text-[40px] font-semibold leading-[1.04] tracking-[-0.035em] sm:text-[62px] lg:text-[72px]">
        Rewiring gene dosage <span class="whitespace-nowrap">without</span> rewriting
        the genome
      </h1>
      <div class="reveal reveal-delay-2 lg:pt-4">
        <p class="max-w-md text-[17px] leading-[1.7] text-ink/65">
          Cells already control genes by folding DNA so that distant regulatory
          elements touch the right promoters. Rewire Bio finds which contact to alter
          for a given disease gene — and says how confident it is.
        </p>
        <a
          href={`${base}/workbench`}
          class="group mt-8 inline-flex items-center gap-2.5 text-[16px] text-clay transition-colors hover:text-ink"
        >
          Open the Workbench
          <span class="transition-transform group-hover:translate-x-1">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ──────────────── Strand canvas ──────────────── -->
  <div id="strand-canvas" class="relative">
    <!-- The helix occupies its own rail; content starts to the right of it so the
         two never overlap. -->
    <svg
      id="helix"
      class="pointer-events-none absolute left-0 top-0 h-full"
      aria-hidden="true"
    ></svg>

    <div class="mx-auto max-w-6xl pb-36 pl-[84px] pr-6 sm:pl-[132px] sm:pr-10">
      <section data-section id="about" class="scroll-mt-28 py-24 sm:py-32">
        <div class="flex items-baseline gap-5">
          <span class="font-mono text-[12px] tabular-nums text-ink/30">01</span>
          <p class="text-[11px] font-medium uppercase tracking-[0.2em] text-clay">About</p>
        </div>
        <h2 class="reveal mt-7 max-w-2xl text-[28px] font-medium leading-[1.22] tracking-[-0.025em] sm:text-[36px]">
          A design system for 3D genome engineering
        </h2>
        <div class="reveal reveal-delay-1 mt-8 grid max-w-4xl gap-x-14 gap-y-6 text-[16px] leading-[1.75] text-ink/60 lg:grid-cols-2">
          <p>
            Many disease genes are hard to drug directly. Gene and epigenetic therapies
            usually rewrite sequence or add new regulatory instructions, which carries
            off-target risk and a long regulatory road.
          </p>
          <p>
            Three-dimensional organisation is a quieter lever. Bringing an enhancer into
            contact with a promoter — or breaking that contact — changes expression using
            machinery the cell already runs, and it is reversible.
          </p>
        </div>

        <ol class="mt-16 grid max-w-4xl gap-x-14 gap-y-10 sm:grid-cols-2">
          {
            steps.map(([title, body], i) => (
              <li class:list={['reveal', `reveal-delay-${Math.min(i + 1, 3)}`]}>
                <h3 class="text-[16px] font-medium tracking-[-0.01em]">
                  <span class="mr-2.5 font-mono text-[12px] text-ink/30">0{i + 1}</span>
                  {title}
                </h3>
                <p class="mt-2 text-[15px] leading-[1.7] text-ink/55">{body}</p>
              </li>
            ))
          }
        </ol>

        <p class="reveal mt-20 max-w-3xl text-[20px] leading-[1.6] tracking-[-0.01em] text-ink/75 sm:text-[22px]">
          Every prediction here is in silico and unvalidated. Effect sizes are the
          weakest link, so we report ordinal tiers rather than numbers that imply
          precision — and show the risks a staple creates alongside the benefit it
          promises.
        </p>
      </section>

      <section data-section id="team" class="scroll-mt-28 py-24 sm:py-32">
        <div class="flex items-baseline gap-5">
          <span class="font-mono text-[12px] tabular-nums text-ink/30">02</span>
          <p class="text-[11px] font-medium uppercase tracking-[0.2em] text-clay">Team</p>
        </div>
        <h2 class="reveal mt-7 text-[28px] font-medium leading-[1.22] tracking-[-0.025em] sm:text-[36px]">
          Built at Anthropic × Modal 2026
        </h2>

        <ul class="mt-14 max-w-4xl">
          {
            team.map(([name, org, role], i) => (
              <li
                class:list={[
                  'reveal',
                  `reveal-delay-${Math.min(i + 1, 3)}`,
                  'grid gap-x-10 gap-y-1 py-7 sm:grid-cols-[minmax(0,15rem)_minmax(0,1fr)]',
                  i > 0 ? 'hairline border-t' : '',
                ]}
              >
                <div>
                  <p class="text-[17px] font-medium tracking-[-0.01em]">{name}</p>
                  <p class="mt-0.5 text-[13px] text-ink/40">{org}</p>
                </div>
                <p class="text-[15px] leading-[1.7] text-ink/55 sm:pt-0.5">{role}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section data-section id="contact" class="scroll-mt-28 py-24 sm:py-32">
        <div class="flex items-baseline gap-5">
          <span class="font-mono text-[12px] tabular-nums text-ink/30">03</span>
          <p class="text-[11px] font-medium uppercase tracking-[0.2em] text-clay">Contact</p>
        </div>
        <h2 class="reveal mt-7 max-w-2xl text-[28px] font-medium leading-[1.22] tracking-[-0.025em] sm:text-[36px]">
          Talk to us
        </h2>
        <p class="reveal reveal-delay-1 mt-7 max-w-xl text-[16px] leading-[1.75] text-ink/60">
          We are looking for collaborators with locus-level experimental capacity. The
          predictions here need testing before they mean anything.
        </p>
        <div class="reveal reveal-delay-2 mt-10 flex flex-wrap items-center gap-x-10 gap-y-3 text-[15px]">
          <a
            href={`${base}/workbench`}
            class="group inline-flex items-center gap-2 text-clay transition-colors hover:text-ink"
          >
            Open the Workbench
            <span class="transition-transform group-hover:translate-x-1">→</span>
          </a>
          <a
            href="https://github.com/nathnwe/hack-anthropic-modal-2026"
            class="text-ink/50 transition-colors hover:text-ink"
            target="_blank"
            rel="noopener"
          >
            GitHub
          </a>
        </div>
      </section>
    </div>
  </div>

  <script is:inline>
    (function () {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const canvas = document.getElementById('strand-canvas');
      const svg = document.getElementById('helix');
      if (!canvas || !svg) return;

      const NS = 'http://www.w3.org/2000/svg';
      let strandA, strandB, rungs = [], nodes = [], lenA = 0, lenB = 0, H = 0;

      // The helix lives in a fixed-width rail at the left edge of the canvas, so it
      // never runs under the text. A node sits on the strand beside each section.
      function build() {
        H = canvas.clientHeight;
        const W = window.innerWidth >= 640 ? 92 : 60;
        if (!H) return;

        svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
        svg.setAttribute('width', W);
        svg.setAttribute('height', H);
        svg.innerHTML = '';
        rungs = [];
        nodes = [];

        const cx = W / 2;
        const amp = W * 0.28;
        const period = 300;
        const step = 4;

        let dA = '', dB = '';
        for (let y = 0; y <= H; y += step) {
          const p = (y / period) * Math.PI * 2;
          dA += (y === 0 ? 'M' : 'L') + (cx + Math.sin(p) * amp).toFixed(1) + ' ' + y;
          dB += (y === 0 ? 'M' : 'L') + (cx + Math.sin(p + Math.PI) * amp).toFixed(1) + ' ' + y;
        }

        const gap = period / 8;
        for (let y = gap; y < H; y += gap) {
          const p = (y / period) * Math.PI * 2;
          const depth = Math.abs(Math.cos(p));
          const r = document.createElementNS(NS, 'line');
          r.setAttribute('x1', (cx + Math.sin(p) * amp).toFixed(1));
          r.setAttribute('y1', y);
          r.setAttribute('x2', (cx + Math.sin(p + Math.PI) * amp).toFixed(1));
          r.setAttribute('y2', y);
          r.setAttribute('stroke', '#20201d');
          r.setAttribute('stroke-width', (0.5 + depth * 0.4).toFixed(2));
          r.setAttribute('stroke-linecap', 'round');
          r.dataset.y = y;
          r.dataset.target = (0.07 + depth * 0.11).toFixed(3);
          r.style.opacity = '0';
          svg.appendChild(r);
          rungs.push(r);
        }

        const mk = (d, stroke, opacity) => {
          const p = document.createElementNS(NS, 'path');
          p.setAttribute('d', d);
          p.setAttribute('fill', 'none');
          p.setAttribute('stroke', stroke);
          p.setAttribute('stroke-width', '1.5');
          p.setAttribute('stroke-linecap', 'round');
          p.setAttribute('opacity', opacity);
          svg.appendChild(p);
          return p;
        };
        strandA = mk(dA, '#a54c38', '0.55');
        strandB = mk(dB, '#748c63', '0.6');

        // A marker on the strand level with each section heading.
        const canvasTop = canvas.getBoundingClientRect().top + window.scrollY;
        canvas.querySelectorAll('[data-section]').forEach((sec) => {
          const y = sec.getBoundingClientRect().top + window.scrollY - canvasTop + 110;
          if (y < 0 || y > H) return;
          const p = (y / period) * Math.PI * 2;
          const c = document.createElementNS(NS, 'circle');
          c.setAttribute('cx', (cx + Math.sin(p) * amp).toFixed(1));
          c.setAttribute('cy', y.toFixed(1));
          c.setAttribute('r', '3.4');
          c.setAttribute('fill', '#a54c38');
          c.dataset.y = y;
          c.style.opacity = '0';
          svg.appendChild(c);
          nodes.push(c);
        });

        lenA = strandA.getTotalLength();
        lenB = strandB.getTotalLength();
        [[strandA, lenA], [strandB, lenB]].forEach(([el, len]) => {
          el.style.strokeDasharray = len;
          el.style.strokeDashoffset = reduce ? 0 : len;
        });

        if (reduce) {
          rungs.forEach((r) => (r.style.opacity = r.dataset.target));
          nodes.forEach((n) => (n.style.opacity = '1'));
        } else {
          update();
        }
      }

      function update() {
        const rect = canvas.getBoundingClientRect();
        const travelled = window.innerHeight * 0.8 - rect.top;
        const progress = Math.max(0, Math.min(1, travelled / Math.max(rect.height, 1)));

        if (strandA) strandA.style.strokeDashoffset = lenA * (1 - progress);
        if (strandB) strandB.style.strokeDashoffset = lenB * (1 - progress);

        const drawnTo = progress * H;
        for (const r of rungs) {
          const o = +r.dataset.y <= drawnTo ? +r.dataset.target : 0;
          if (r.style.opacity !== String(o)) {
            r.style.transition = 'opacity 400ms ease-out';
            r.style.opacity = o;
          }
        }
        for (const n of nodes) {
          const o = +n.dataset.y <= drawnTo ? 1 : 0;
          if (n.style.opacity !== String(o)) {
            n.style.transition = 'opacity 500ms ease-out';
            n.style.opacity = o;
          }
        }
      }

      let ticking = false;
      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          update();
          ticking = false;
        });
      }

      build();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', () => {
        clearTimeout(window.__rb);
        window.__rb = setTimeout(build, 180);
      });
      setTimeout(build, 700);
    })();
  </script>
</Base>
