---
import Base from '../layouts/Base.astro';
import catalogue from '../data/strategies.json';

const records = Object.values(
  import.meta.glob('../../public/data/*.json', { eager: true, import: 'default' })
) as any[];

const genes = records.sort((a, b) => a.gene.symbol.localeCompare(b.gene.symbol));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const label: Record<string, string> = {
  yes: 'Mammalian',
  strong: 'Strong',
  bacterial: 'Bacterial only',
  concept: 'Proof of concept',
  no: 'No',
  depends: 'Depends',
  not_inherent: 'Not inherently',
};

const strong = (v: string) => v === 'yes' || v === 'strong';
---

<Base title="Results — Rewire Bio">
  <style>
    .viz {
      --gene: #2a6fa8;
      --cre: #a54c38;
      --axis: rgba(32, 32, 29, 0.22);
    }
    select.bare {
      appearance: none;
      background: transparent;
    }
  </style>

  <div class="mx-auto max-w-6xl px-6 py-14 sm:px-10">
    <!-- Query -->
    <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-5">
      <div>
        <p class="text-[11px] font-medium uppercase tracking-[0.2em] text-clay">Results</p>
        <h1 class="mt-3 flex flex-wrap items-baseline gap-x-3">
          <span id="gene-title" class="font-mono text-[34px] font-medium tracking-tight"></span>
          <span id="intent-title" class="text-[16px] text-ink/45"></span>
        </h1>
        <p id="disease-line" class="mt-1.5 text-[14px] text-ink/45"></p>
      </div>

      <div class="flex items-center gap-6 text-[14px]">
        <select id="gene-select" class="bare hairline border-0 border-b pb-1 font-mono text-ink outline-none focus:border-clay">
          {genes.map((r) => <option value={r.gene.symbol}>{r.gene.symbol}</option>)}
        </select>
        <select id="intent-select" class="bare hairline border-0 border-b pb-1 text-ink outline-none focus:border-clay">
          <option value="up">Upregulate</option>
          <option value="down">Downregulate</option>
          <option value="off">Silence</option>
        </select>
        <a href={`${base}/workbench`} class="text-ink/40 transition-colors hover:text-ink">New query</a>
      </div>
    </div>

    <p id="intent-note" class="mt-7 hidden text-[14px] leading-relaxed text-clay"></p>
    <p id="illustrative-banner" class="mt-7 hidden text-[14px] leading-relaxed text-ink/55">
      <span class="font-medium text-ink">Illustrative record.</span>
      Coordinates and scores are placeholders, not findings.
    </p>

    <div class="mt-14 grid gap-x-14 gap-y-14 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)]">
      <!-- Elements -->
      <section>
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <h2 class="text-[11px] font-medium uppercase tracking-[0.2em] text-ink/40">
            Regulatory elements
          </h2>
          <label class="flex items-center gap-2 text-[13px] text-ink/40">
            Rank by
            <select id="rank-select" class="bare hairline border-0 border-b pb-0.5 text-ink outline-none focus:border-clay">
              <option value="auto">Auto</option>
              <option value="potency">Potency</option>
              <option value="contact">Contact strength</option>
              <option value="achievability">Achievability</option>
              <option value="safety" disabled>Safety — pending</option>
            </select>
          </label>
        </div>
        <p id="rank-explainer" class="mt-3 text-[13px] leading-relaxed text-ink/40"></p>
        <ul id="cre-list" class="mt-7"></ul>
      </section>

      <!-- Contacts -->
      <section class="viz h-fit">
        <div class="flex items-baseline justify-between">
          <h2 class="text-[11px] font-medium uppercase tracking-[0.2em] text-ink/40">
            Contacts within TAD
          </h2>
          <span id="tad-label" class="font-mono text-[12px] text-ink/35"></span>
        </div>
        <svg id="loop-svg" viewBox="0 0 760 250" class="mt-5 w-full" role="img"
             aria-label="Arc diagram of enhancer–promoter contacts across the TAD"></svg>
        <div class="mt-3 flex flex-wrap items-center gap-x-6 gap-y-1.5 text-[12px] text-ink/40">
          <span class="flex items-center gap-2">
            <span class="h-2.5 w-2.5 rounded-full" style="background:var(--gene)"></span> Promoter
          </span>
          <span class="flex items-center gap-2">
            <span class="h-2.5 w-2.5 rounded-full" style="background:var(--cre)"></span> Element
          </span>
          <span>Arc thickness = contact strength</span>
        </div>
      </section>
    </div>

    <!-- Staples -->
    <section class="mt-20">
      <h2 class="text-[11px] font-medium uppercase tracking-[0.2em] text-ink/40">
        Candidate staples
      </h2>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full text-left">
          <thead>
            <tr class="hairline border-b text-[11px] uppercase tracking-[0.12em] text-ink/35">
              <th class="pb-3 pr-6 font-medium">Staple</th>
              <th class="pb-3 pr-6 font-medium">Anchors</th>
              <th class="pb-3 pr-6 font-medium">Mode</th>
              <th class="pb-3 pr-6 font-medium">Tier</th>
              <th class="pb-3 font-medium">Risks</th>
            </tr>
          </thead>
          <tbody id="staple-body"></tbody>
        </table>
      </div>
      <p id="staple-rationale" class="mt-5 text-[13px] leading-relaxed text-ink/45"></p>
    </section>

    <!-- Strategies -->
    <section class="mt-20">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h2 class="text-[11px] font-medium uppercase tracking-[0.2em] text-ink/40">
          Stapling strategies
        </h2>
        <span class="text-[12px] text-ink/35">
          Method properties — not locus-specific predictions
        </span>
      </div>

      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[860px] text-left">
          <thead>
            <tr class="hairline border-b text-[11px] uppercase tracking-[0.12em] text-ink/35">
              <th class="pb-3 pr-6 font-medium">Strategy</th>
              <th class="pb-3 pr-6 font-medium">How the staple works</th>
              <th class="pb-3 pr-6 font-medium">Mammalian</th>
              <th class="pb-3 pr-6 font-medium">Switchable</th>
              <th class="pb-3 pr-6 font-medium">Attraction</th>
              <th class="pb-3 font-medium">Main issue</th>
            </tr>
          </thead>
          <tbody>
            {
              catalogue.strategies.map((s) => (
                <tr class="hairline border-b align-top">
                  <td class="py-5 pr-6 text-[14px] font-medium leading-snug">{s.name}</td>
                  <td class="py-5 pr-6 text-[13px] leading-relaxed text-ink/55">{s.how}</td>
                  <td class="py-5 pr-6 text-[13px]">
                    <span class:list={[strong(s.mammalian) ? 'text-olive' : 'text-ink/40']}>
                      {label[s.mammalian] ?? s.mammalian}
                    </span>
                  </td>
                  <td class="py-5 pr-6 text-[13px]">
                    <span
                      class:list={[
                        s.switchable === 'strong'
                          ? 'text-olive'
                          : s.switchable === 'yes'
                            ? 'text-ink/70'
                            : s.switchable === 'no'
                              ? 'text-clay'
                              : 'text-ink/40',
                      ]}
                    >
                      {label[s.switchable] ?? s.switchable}
                    </span>
                  </td>
                  <td class="py-5 pr-6 text-[13px] leading-relaxed text-ink/55">{s.attraction}</td>
                  <td class="py-5 text-[13px] leading-relaxed text-ink/40">{s.issue}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <script set:html={`window.__GENES__ = ${JSON.stringify(genes)};`} is:inline />

  <script is:inline>
    (function () {
      const genes = window.__GENES__;
      const bySymbol = Object.fromEntries(genes.map((r) => [r.gene.symbol, r]));
      const $ = (id) => document.getElementById(id);
      const fmt = (n) => n.toLocaleString();

      const RANK_EXPLAIN = {
        auto: 'Composite of rE2G score and modelled contact strength. Ordinal, not calibrated.',
        potency: 'ENCODE-rE2G enhancer–gene score alone — predicted regulatory effect on this gene.',
        contact: 'Modelled 3D contact frequency with the promoter, independent of regulatory score.',
        achievability:
          'Distance from the TSS — shorter spans are generally easier to staple. A proxy, not a measured success rate.',
      };

      function confidence(score) {
        if (score >= 0.7) return { label: 'High', cls: 'text-olive' };
        if (score >= 0.4) return { label: 'Medium', cls: 'text-ink/55' };
        return { label: 'Low', cls: 'text-ink/35' };
      }

      function contactFor(record, cre) {
        const tss = record.gene.tss;
        const mid = (cre.start + cre.end) / 2;
        return (record.locus.contacts || []).find(
          (c) =>
            (Math.abs(c.a - tss) < 50000 && Math.abs(c.b - mid) < 50000) ||
            (Math.abs(c.b - tss) < 50000 && Math.abs(c.a - mid) < 50000)
        );
      }

      // Evidence comes from the record. URLs and PMIDs are linkified, placeholders
      // flagged. We never synthesise a citation.
      function evidenceHtml(record) {
        const items = record.gene.evidence || [];
        if (!items.length) return '<p class="text-[13px] text-ink/35">No sources recorded.</p>';
        return (
          '<ul class="space-y-1.5">' +
          items
            .map((e) => {
              if (/^PLACEHOLDER/i.test(e))
                return '<li class="text-[13px] text-clay/80">' + e + '</li>';
              const url = e.match(/https?:\/\/\S+/);
              const pmid = e.match(/PMID[:\s]*(\d+)/i);
              if (url)
                return '<li><a class="text-[13px] text-clay underline underline-offset-2 hover:text-ink" target="_blank" rel="noopener" href="' + url[0] + '">' + e + '</a></li>';
              if (pmid)
                return '<li><a class="text-[13px] text-clay underline underline-offset-2 hover:text-ink" target="_blank" rel="noopener" href="https://pubmed.ncbi.nlm.nih.gov/' + pmid[1] + '/">' + e + '</a></li>';
              return '<li class="text-[13px] text-ink/55">' + e + '</li>';
            })
            .join('') +
          '</ul>'
        );
      }

      let selectedCre = null;
      let openCre = null;

      function rankedCres(record, mode) {
        const tss = record.gene.tss;
        const list = [...record.locus.cres];
        const strength = (c) => (contactFor(record, c) || {}).strength || 0;
        const dist = (c) => Math.abs((c.start + c.end) / 2 - tss);
        if (mode === 'potency') return list.sort((a, b) => b.score_rE2G - a.score_rE2G);
        if (mode === 'contact') return list.sort((a, b) => strength(b) - strength(a));
        if (mode === 'achievability') return list.sort((a, b) => dist(a) - dist(b));
        return list.sort(
          (a, b) => b.score_rE2G * (0.5 + strength(b)) - a.score_rE2G * (0.5 + strength(a))
        );
      }

      function render() {
        const record = bySymbol[$('gene-select').value];
        const intent = $('intent-select').value;
        const mode = $('rank-select').value;

        $('gene-title').textContent = record.gene.symbol;
        $('intent-title').textContent = { up: 'upregulate', down: 'downregulate', off: 'silence' }[intent];
        $('disease-line').textContent = record.gene.disease + ' · ' + record.locus.cell_type;
        $('illustrative-banner').classList.toggle('hidden', !record.illustrative);

        const dir = record.gene.direction;
        const clash =
          (dir === 'too_much' && intent === 'up') ||
          (dir === 'too_little' && (intent === 'down' || intent === 'off'));
        $('intent-note').textContent = clash
          ? 'This gene is pathogenic when ' +
            (dir === 'too_much' ? 'overexpressed' : 'underexpressed') +
            '. Your query moves expression the wrong way for the recorded disease.'
          : '';
        $('intent-note').classList.toggle('hidden', !clash);
        $('rank-explainer').textContent = RANK_EXPLAIN[mode] || '';

        const cres = rankedCres(record, mode);
        $('cre-list').innerHTML = cres
          .map((cre, i) => {
            const conf = confidence(cre.score_rE2G);
            const contact = contactFor(record, cre);
            const d = Math.abs((cre.start + cre.end) / 2 - record.gene.tss);
            const open = cre.id === openCre;
            const short = cre.id.split('_').pop();
            return `
              <li class="hairline border-b ${cre.id === selectedCre ? 'bg-parchment-deep/50' : ''}">
                <div class="flex items-center gap-4 py-5">
                  <span class="w-4 shrink-0 font-mono text-[12px] tabular-nums text-ink/25">${i + 1}</span>
                  <button data-sel="${cre.id}" class="min-w-0 flex-1 text-left">
                    <span class="flex flex-wrap items-baseline gap-x-3">
                      <span class="font-mono text-[16px] font-medium">${short}</span>
                      <span class="font-mono text-[12px] text-ink/40">chr${record.gene.chrom}:${fmt(cre.start)}-${fmt(cre.end)}</span>
                    </span>
                    <span class="mt-1 block text-[13px] text-ink/45">
                      ${cre.type} · ${contact ? 'TAD contact' : 'linear proximity'} · ${fmt(Math.round(d / 1000))} kb from TSS
                    </span>
                  </button>
                  <span class="shrink-0 text-[13px] ${conf.cls}">${conf.label}</span>
                  <button data-info="${cre.id}" aria-expanded="${open}" title="Scoring detail and evidence"
                    class="hairline flex h-6 w-6 shrink-0 items-center justify-center rounded-full border text-[11px] transition-colors ${
                      open ? 'border-clay text-clay' : 'text-ink/35 hover:text-ink'
                    }">i</button>
                </div>
                ${
                  open
                    ? `<div class="pb-7 pl-8">
                        <p class="text-[11px] font-medium uppercase tracking-[0.16em] text-ink/35">Scoring criteria</p>
                        <dl class="mt-4 grid gap-x-10 gap-y-3 sm:grid-cols-2">
                          ${[
                            ['rE2G score', cre.score_rE2G.toFixed(2)],
                            ['Contact strength', contact ? contact.strength.toFixed(2) : 'none modelled'],
                            ['Distance to TSS', fmt(Math.round(d)) + ' bp'],
                            ['Element type', cre.type],
                          ]
                            .map(
                              ([k, v]) =>
                                `<div class="hairline flex justify-between gap-4 border-b pb-2">
                                   <dt class="text-[13px] text-ink/45">${k}</dt>
                                   <dd class="font-mono text-[13px]">${v}</dd>
                                 </div>`
                            )
                            .join('')}
                        </dl>
                        <p class="mt-4 text-[12px] leading-relaxed text-ink/35">
                          rE2G scores are ENCODE enhancer–gene predictions; contact strength is modelled, not measured in this cell type.
                        </p>
                        <p class="mt-7 text-[11px] font-medium uppercase tracking-[0.16em] text-ink/35">Literature</p>
                        <div class="mt-3">${evidenceHtml(record)}</div>
                        <p class="mt-3 text-[12px] leading-relaxed text-ink/35">
                          Sources are recorded against the gene, not this element. Element-level citations are not yet in the contract.
                        </p>
                      </div>`
                    : ''
                }
              </li>`;
          })
          .join('');

        $('cre-list').querySelectorAll('button[data-sel]').forEach((b) =>
          b.addEventListener('click', () => {
            selectedCre = selectedCre === b.dataset.sel ? null : b.dataset.sel;
            render();
          })
        );
        $('cre-list').querySelectorAll('button[data-info]').forEach((b) =>
          b.addEventListener('click', () => {
            openCre = openCre === b.dataset.info ? null : b.dataset.info;
            render();
          })
        );

        drawLoop(record);
        drawStaples(record);
      }

      function drawLoop(record) {
        const tad = record.locus.tad;
        const W = 760, PAD = 40, AXIS = 190, H = 250;
        const span = Math.max(tad.end - tad.start, 1);
        const x = (bp) => PAD + ((bp - tad.start) / span) * (W - 2 * PAD);
        $('tad-label').textContent = `chr${tad.chrom}:${fmt(tad.start)}-${fmt(tad.end)}`;

        let out = '';
        (record.locus.contacts || []).forEach((c) => {
          const x1 = x(c.a), x2 = x(c.b);
          const mid = (x1 + x2) / 2;
          const h = Math.min(140, Math.abs(x2 - x1) * 0.55);
          const near = record.locus.cres.find(
            (cre) =>
              Math.abs((cre.start + cre.end) / 2 - c.b) < 50000 ||
              Math.abs((cre.start + cre.end) / 2 - c.a) < 50000
          );
          const dim = selectedCre && (!near || near.id !== selectedCre);
          out += `<path d="M ${x1} ${AXIS} Q ${mid} ${AXIS - h} ${x2} ${AXIS}" fill="none"
            stroke="var(--gene)" stroke-width="${1.4 + c.strength * 3.4}"
            opacity="${dim ? 0.15 : 0.7}" stroke-linecap="round" />`;
        });

        out += `<line x1="${PAD}" y1="${AXIS}" x2="${W - PAD}" y2="${AXIS}" stroke="var(--axis)" stroke-width="1.5" />`;

        record.locus.cres.forEach((cre) => {
          const cx = x((cre.start + cre.end) / 2);
          const sel = cre.id === selectedCre;
          const w = Math.max(6, x(cre.end) - x(cre.start));
          out += `<rect x="${cx - w / 2}" y="${AXIS - 6}" width="${w}" height="12" rx="3"
            fill="var(--cre)" opacity="${sel || !selectedCre ? 1 : 0.28}" stroke="#f2eedf" stroke-width="2" />`;
          out += `<text x="${cx}" y="${AXIS + 26}" text-anchor="middle" font-size="11"
            font-family="ui-monospace,monospace" fill="${sel ? '#20201d' : 'rgba(32,32,29,0.45)'}">${cre.id.split('_').pop()}</text>`;
        });

        const tx = x(record.gene.tss);
        out += `<rect x="${tx - 3.5}" y="${AXIS - 10}" width="7" height="20" rx="2" fill="var(--gene)" stroke="#f2eedf" stroke-width="2" />`;
        out += `<text x="${tx}" y="${AXIS + 26}" text-anchor="middle" font-size="11"
          font-family="ui-monospace,monospace" font-weight="600" fill="#20201d">${record.gene.symbol}</text>`;
        out += `<text x="${PAD}" y="${H - 8}" font-size="10" fill="rgba(32,32,29,0.35)">${fmt(tad.start)}</text>`;
        out += `<text x="${W - PAD}" y="${H - 8}" text-anchor="end" font-size="10" fill="rgba(32,32,29,0.35)">${fmt(tad.end)}</text>`;
        $('loop-svg').innerHTML = out;
      }

      function drawStaples(record) {
        const tierCls = { A: 'text-olive', B: 'text-ochre', C: 'text-ink/45' };
        const rows = (record.staples || []).map((s) => {
          const rank = (record.ranking || []).find((r) => r.staple_id === s.id);
          const risk = (record.risks || []).find((r) => r.staple_id === s.id);
          const flags = risk?.flags || [];
          return `
            <tr class="hairline border-b align-top">
              <td class="py-5 pr-6 font-mono text-[13px]">${s.id.split('_').pop()}</td>
              <td class="py-5 pr-6 font-mono text-[12px] leading-relaxed text-ink/45">
                ${fmt(s.anchor_a.start)}<br />${fmt(s.anchor_b.start)}
              </td>
              <td class="py-5 pr-6 text-[13px]">
                ${s.mode}<span class="block text-ink/40">${s.predicted_delta.replace(/_/g, ' ')}</span>
              </td>
              <td class="py-5 pr-6 text-[16px] font-medium ${tierCls[rank?.tier] || 'text-ink/35'}">${rank?.tier ?? '—'}</td>
              <td class="py-5 text-[13px]">
                ${
                  flags.length
                    ? flags
                        .map(
                          (f) =>
                            `<span class="mr-3 ${
                              f.severity === 'high' ? 'text-clay' : f.severity === 'medium' ? 'text-ochre' : 'text-ink/40'
                            }" title="${f.detail}">${f.type}</span>`
                        )
                        .join('')
                    : '<span class="text-ink/30">none recorded</span>'
                }
              </td>
            </tr>`;
        });
        $('staple-body').innerHTML = rows.length
          ? rows.join('')
          : '<tr><td colspan="5" class="py-6 text-[14px] text-ink/40">No candidate staples.</td></tr>';

        const first = (record.ranking || [])[0];
        $('staple-rationale').textContent = first
          ? 'Recommended: ' + first.method_recommendation +
            (first.rationale?.length ? ' — ' + first.rationale.join('; ') : '')
          : '';
      }

      const params = new URLSearchParams(location.search);
      const wanted = (params.get('gene') || '').toUpperCase();
      if (wanted && bySymbol[wanted]) $('gene-select').value = wanted;
      const qIntent = params.get('intent');
      if (qIntent && ['up', 'down', 'off'].includes(qIntent)) $('intent-select').value = qIntent;
      const qRank = params.get('rank');
      if (qRank) $('rank-select').value = qRank;

      function syncUrl() {
        const q = new URLSearchParams({
          gene: $('gene-select').value,
          intent: $('intent-select').value,
          rank: $('rank-select').value,
        });
        history.replaceState(null, '', location.pathname + '?' + q);
      }

      ['gene-select', 'intent-select', 'rank-select'].forEach((id) =>
        $(id).addEventListener('change', () => {
          if (id === 'gene-select') {
            selectedCre = null;
            openCre = null;
          }
          syncUrl();
          render();
        })
      );

      syncUrl();
      render();
    })();
  </script>
</Base>
