---
import Base from '../layouts/Base.astro';

// All gene records, embedded so the page stays fully static on GitHub Pages.
const records = Object.values(
  import.meta.glob('../../public/data/*.json', { eager: true, import: 'default' })
) as any[];

const genes = records.sort((a, b) => a.gene.symbol.localeCompare(b.gene.symbol));
---

<Base title="Search — 3D genome engineering">
  <!-- Chart roles. Blue = gene/promoter, orange = CRE. Validated for the dark
       surface: normal-vision dE 31.8, protan 26.8, both well above the floor. -->
  <style>
    .viz {
      --gene: #3987e5;
      --cre: #d95926;
      --axis: #44485a;
    }
  </style>

  <header class="flex flex-wrap items-end justify-between gap-4 border-b border-slate-800 pb-5">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-sky-400">
        Target search
      </p>
      <h1 class="mt-1 text-xl font-semibold tracking-tight text-white">
        Candidate regulatory elements
      </h1>
    </div>
    <a href={`${import.meta.env.BASE_URL}/`} class="text-xs text-slate-500 hover:text-slate-300">
      ← All genes
    </a>
  </header>

  <!-- Query row -->
  <div class="mt-6 flex flex-wrap items-end gap-3">
    <label class="flex flex-col gap-1.5">
      <span class="text-xs font-medium text-slate-500">Gene</span>
      <select
        id="gene-select"
        class="w-44 rounded-md border border-slate-700 bg-slate-900 px-3 py-2 font-mono text-sm text-white focus:border-sky-500 focus:outline-none"
      >
        {genes.map((r) => <option value={r.gene.symbol}>{r.gene.symbol}</option>)}
      </select>
    </label>

    <label class="flex flex-col gap-1.5">
      <span class="text-xs font-medium text-slate-500">Intent</span>
      <select
        id="intent-select"
        class="w-44 rounded-md border border-slate-700 bg-slate-900 px-3 py-2 text-sm text-white focus:border-sky-500 focus:outline-none"
      >
        <option value="up">Upregulate</option>
        <option value="down">Downregulate</option>
        <option value="off">Silence</option>
      </select>
    </label>

    <label class="flex items-center gap-2 pb-2.5 text-sm text-slate-400">
      <input
        id="high-only"
        type="checkbox"
        class="h-4 w-4 rounded border-slate-600 bg-slate-900 accent-sky-500"
      />
      High confidence only
    </label>

    <p id="intent-note" class="pb-2.5 text-xs text-amber-400/90"></p>
  </div>

  <div id="illustrative-banner" class="mt-5 hidden rounded-lg border border-amber-500/40 bg-amber-500/10 px-4 py-3">
    <p class="text-sm text-amber-200/90">
      <span class="font-semibold text-amber-300">Illustrative record.</span>
      Coordinates and scores are placeholders, not findings.
    </p>
  </div>

  <!-- Two columns: CRE list | loop view + strategy -->
  <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)]">
    <!-- Left: ranked CRE list -->
    <section class="rounded-xl border border-slate-800 bg-slate-900/40">
      <div class="flex items-baseline justify-between border-b border-slate-800 px-4 py-3">
        <h2 class="text-xs font-semibold uppercase tracking-widest text-slate-500">
          Regulatory elements
        </h2>
        <span id="cre-count" class="text-xs text-slate-600"></span>
      </div>
      <ul id="cre-list" class="divide-y divide-slate-800"></ul>
    </section>

    <!-- Right: contact view, then strategy -->
    <div class="flex flex-col gap-6">
      <section class="viz rounded-xl border border-slate-800 bg-slate-900/40 p-4">
        <div class="flex items-baseline justify-between">
          <h2 class="text-xs font-semibold uppercase tracking-widest text-slate-500">
            Contacts within TAD
          </h2>
          <span id="tad-label" class="font-mono text-xs text-slate-600"></span>
        </div>

        <svg id="loop-svg" viewBox="0 0 760 250" class="mt-2 w-full" role="img"
             aria-label="Arc diagram of enhancer–promoter contacts across the TAD"></svg>

        <div class="mt-1 flex flex-wrap items-center gap-x-5 gap-y-1 text-xs text-slate-500">
          <span class="flex items-center gap-1.5">
            <span class="h-2.5 w-2.5 rounded-sm" style="background:var(--gene)"></span> Promoter / TSS
          </span>
          <span class="flex items-center gap-1.5">
            <span class="h-2.5 w-2.5 rounded-sm" style="background:var(--cre)"></span> Regulatory element
          </span>
          <span>Arc thickness = contact strength</span>
        </div>
      </section>

      <section class="rounded-xl border border-slate-800 bg-slate-900/40">
        <h2 class="border-b border-slate-800 px-4 py-3 text-xs font-semibold uppercase tracking-widest text-slate-500">
          Strategy
        </h2>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead>
              <tr class="text-xs uppercase tracking-wider text-slate-600">
                <th class="px-4 py-2 font-medium">Staple</th>
                <th class="px-4 py-2 font-medium">Mode</th>
                <th class="px-4 py-2 font-medium">Tier</th>
                <th class="px-4 py-2 font-medium">Method</th>
              </tr>
            </thead>
            <tbody id="strategy-body" class="divide-y divide-slate-800"></tbody>
          </table>
        </div>
      </section>
    </div>
  </div>

  <p class="mt-8 text-xs text-slate-600">
    In silico predictions, not experimentally validated. Confidence tiers are derived
    from ENCODE-rE2G scores and are ordinal, not probabilities.
  </p>

  <script set:html={`window.__GENES__ = ${JSON.stringify(genes)};`} is:inline />

  <script is:inline>
    (function () {
      const genes = window.__GENES__;
      const bySymbol = Object.fromEntries(genes.map((r) => [r.gene.symbol, r]));

      const $ = (id) => document.getElementById(id);
      const fmt = (n) => n.toLocaleString();

      // rE2G score -> ordinal confidence. Thresholds are display conventions,
      // not calibrated probabilities; the label always travels with the color.
      function confidence(score) {
        if (score >= 0.7) return { label: 'High', rank: 3, cls: 'text-sky-300 border-sky-500/40 bg-sky-500/10' };
        if (score >= 0.4) return { label: 'Medium', rank: 2, cls: 'text-slate-300 border-slate-600 bg-slate-700/30' };
        return { label: 'Low', rank: 1, cls: 'text-slate-500 border-slate-700 bg-slate-800/30' };
      }

      // A CRE is a "TAD contact" when the record carries a contact between it and
      // the TSS; otherwise we only know it is linearly nearby.
      function association(record, cre) {
        const tss = record.gene.tss;
        const mid = (cre.start + cre.end) / 2;
        const hit = (record.locus.contacts || []).find(
          (c) =>
            (Math.abs(c.a - tss) < 50000 && Math.abs(c.b - mid) < 50000) ||
            (Math.abs(c.b - tss) < 50000 && Math.abs(c.a - mid) < 50000)
        );
        return hit
          ? { label: 'TAD contact', strength: hit.strength }
          : { label: 'Linear proximity', strength: null };
      }

      let selectedCre = null;

      function render() {
        const record = bySymbol[$('gene-select').value];
        const intent = $('intent-select').value;
        const highOnly = $('high-only').checked;

        $('illustrative-banner').classList.toggle('hidden', !record.illustrative);

        // Direction sanity note: flag when the intent fights the disease biology.
        const dir = record.gene.direction;
        const note =
          dir === 'too_much' && intent === 'up'
            ? 'This gene is pathogenic when overexpressed.'
            : dir === 'too_little' && (intent === 'down' || intent === 'off')
              ? 'This gene is pathogenic when underexpressed.'
              : '';
        $('intent-note').textContent = note;

        // ---- Left list ----
        const cres = [...record.locus.cres].sort((a, b) => b.score_rE2G - a.score_rE2G);
        const shown = highOnly ? cres.filter((c) => confidence(c.score_rE2G).rank === 3) : cres;
        $('cre-count').textContent = shown.length + ' of ' + cres.length;

        $('cre-list').innerHTML = shown
          .map((cre) => {
            const conf = confidence(cre.score_rE2G);
            const assoc = association(record, cre);
            const active = cre.id === selectedCre;
            return `
              <li>
                <button data-cre="${cre.id}"
                  class="flex w-full items-center gap-4 px-4 py-3 text-left transition hover:bg-slate-800/40 ${
                    active ? 'bg-slate-800/60' : ''
                  }">
                  <span class="w-14 shrink-0 font-mono text-sm font-semibold text-white">${cre.id.split('_').pop()}</span>
                  <span class="min-w-0 flex-1">
                    <span class="block font-mono text-xs text-slate-400">chr${record.gene.chrom}:${fmt(cre.start)}-${fmt(cre.end)}</span>
                    <span class="mt-0.5 block text-xs text-slate-500">${cre.type} · ${assoc.label}</span>
                  </span>
                  <span class="shrink-0 rounded-full border px-2 py-0.5 text-xs font-medium ${conf.cls}">${conf.label}</span>
                </button>
              </li>`;
          })
          .join('');

        if (!shown.length) {
          $('cre-list').innerHTML =
            '<li class="px-4 py-6 text-sm text-slate-500">No elements at this confidence.</li>';
        }

        $('cre-list')
          .querySelectorAll('button[data-cre]')
          .forEach((b) =>
            b.addEventListener('click', () => {
              selectedCre = selectedCre === b.dataset.cre ? null : b.dataset.cre;
              render();
            })
          );

        drawLoop(record, shown);
        drawStrategy(record);
      }

      // ---- Arc diagram: genome axis + contact arcs ----
      function drawLoop(record, shown) {
        const tad = record.locus.tad;
        const W = 760, H = 250, PAD = 40, AXIS = 190;
        const span = Math.max(tad.end - tad.start, 1);
        const x = (bp) => PAD + ((bp - tad.start) / span) * (W - 2 * PAD);

        $('tad-label').textContent =
          `chr${tad.chrom}:${fmt(tad.start)}-${fmt(tad.end)}`;

        const tss = record.gene.tss;
        const visible = new Set(shown.map((c) => c.id));
        let out = '';

        // Arcs first, so marks sit on top.
        (record.locus.contacts || []).forEach((c) => {
          const x1 = x(c.a), x2 = x(c.b);
          const mid = (x1 + x2) / 2;
          const height = Math.min(140, Math.abs(x2 - x1) * 0.55);
          const near = record.locus.cres.find(
            (cre) => Math.abs((cre.start + cre.end) / 2 - c.b) < 50000 || Math.abs((cre.start + cre.end) / 2 - c.a) < 50000
          );
          const dim = selectedCre && (!near || near.id !== selectedCre);
          out += `<path d="M ${x1} ${AXIS} Q ${mid} ${AXIS - height} ${x2} ${AXIS}"
            fill="none" stroke="var(--gene)" stroke-width="${1.5 + c.strength * 4}"
            opacity="${dim ? 0.15 : 0.55}" stroke-linecap="round" />`;
        });

        // Axis
        out += `<line x1="${PAD}" y1="${AXIS}" x2="${W - PAD}" y2="${AXIS}" stroke="var(--axis)" stroke-width="2" />`;

        // CRE marks
        record.locus.cres.forEach((cre) => {
          const cx = x((cre.start + cre.end) / 2);
          const on = visible.has(cre.id);
          const sel = cre.id === selectedCre;
          const w = Math.max(6, x(cre.end) - x(cre.start));
          out += `<rect x="${cx - w / 2}" y="${AXIS - 7}" width="${w}" height="14" rx="3"
            fill="var(--cre)" opacity="${on ? (sel || !selectedCre ? 1 : 0.3) : 0.15}"
            stroke="#0f172a" stroke-width="2" />`;
          if (sel || on) {
            out += `<text x="${cx}" y="${AXIS + 26}" text-anchor="middle"
              font-size="11" font-family="ui-monospace,monospace"
              fill="${sel ? '#e2e8f0' : '#64748b'}">${cre.id.split('_').pop()}</text>`;
          }
        });

        // TSS mark + label
        const tx = x(tss);
        out += `<rect x="${tx - 4}" y="${AXIS - 11}" width="8" height="22" rx="2"
          fill="var(--gene)" stroke="#0f172a" stroke-width="2" />`;
        out += `<text x="${tx}" y="${AXIS + 26}" text-anchor="middle" font-size="11"
          font-family="ui-monospace,monospace" font-weight="600" fill="#e2e8f0">${record.gene.symbol}</text>`;

        // Scale caption
        out += `<text x="${PAD}" y="${H - 8}" font-size="10" fill="#475569">${fmt(tad.start)}</text>`;
        out += `<text x="${W - PAD}" y="${H - 8}" text-anchor="end" font-size="10" fill="#475569">${fmt(tad.end)}</text>`;

        $('loop-svg').innerHTML = out;
      }

      // ---- Strategy table ----
      function drawStrategy(record) {
        const tierCls = { A: 'text-emerald-300', B: 'text-amber-300', C: 'text-slate-400' };
        const rows = (record.staples || []).map((s) => {
          const rank = (record.ranking || []).find((r) => r.staple_id === s.id);
          const risk = (record.risks || []).find((r) => r.staple_id === s.id);
          const worst = (risk?.flags || []).some((f) => f.severity === 'high')
            ? 'high'
            : (risk?.flags || []).some((f) => f.severity === 'medium')
              ? 'medium'
              : null;
          return `
            <tr class="align-top">
              <td class="px-4 py-3 font-mono text-xs text-slate-300">
                ${s.id.split('_').pop()}
                ${worst ? `<span class="ml-1.5 text-xs ${worst === 'high' ? 'text-red-400' : 'text-amber-400'}">⚑ ${worst} risk</span>` : ''}
              </td>
              <td class="px-4 py-3 text-xs text-slate-400">
                ${s.mode}
                <span class="block text-slate-600">${s.predicted_delta.replace(/_/g, ' ')}</span>
              </td>
              <td class="px-4 py-3 text-sm font-semibold ${tierCls[rank?.tier] || 'text-slate-500'}">
                ${rank?.tier ?? '—'}
              </td>
              <td class="px-4 py-3 text-xs text-slate-400">${rank?.method_recommendation ?? '—'}</td>
            </tr>`;
        });

        $('strategy-body').innerHTML = rows.length
          ? rows.join('')
          : '<tr><td colspan="4" class="px-4 py-6 text-sm text-slate-500">No candidate staples.</td></tr>';
      }

      // Deep link: /search?gene=MYC&intent=down selects that state on load, and the
      // URL tracks the controls so any view can be copied and shared.
      const params = new URLSearchParams(location.search);
      const wanted = params.get('gene');
      if (wanted && bySymbol[wanted]) $('gene-select').value = wanted;
      const intent = params.get('intent');
      if (intent && ['up', 'down', 'off'].includes(intent)) $('intent-select').value = intent;

      function syncUrl() {
        const q = new URLSearchParams({
          gene: $('gene-select').value,
          intent: $('intent-select').value,
        });
        history.replaceState(null, '', location.pathname + '?' + q);
      }

      ['gene-select', 'intent-select', 'high-only'].forEach((id) =>
        $(id).addEventListener('change', () => {
          if (id === 'gene-select') selectedCre = null;
          syncUrl();
          render();
        })
      );

      syncUrl();
      render();
    })();
  </script>
</Base>
