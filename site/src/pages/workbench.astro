---
import Base from '../layouts/Base.astro';

const records = Object.values(
  import.meta.glob('../../public/data/*.json', { eager: true, import: 'default' })
) as any[];

const genes = records.sort((a, b) => a.gene.symbol.localeCompare(b.gene.symbol));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Workbench — Rewire Bio">
  <div class="mx-auto flex min-h-[70vh] max-w-2xl flex-col justify-center px-4 py-20 sm:px-6">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-400">Workbench</p>
    <h1 class="mt-4 text-3xl font-semibold tracking-tight text-white">
      What would you like to retune?
    </h1>
    <p class="mt-3 text-slate-400">
      Name a dosage-sensitive gene and the direction of change you want. We return the
      regulatory elements in its TAD, ranked, with candidate staples and their risks.
    </p>

    <form id="query-form" class="mt-9 space-y-4" action={`${base}/results`} method="get">
      <div>
        <label for="gene" class="block text-xs font-medium text-slate-500">Gene</label>
        <input
          id="gene"
          name="gene"
          list="gene-options"
          required
          autocomplete="off"
          placeholder="e.g. MYC"
          class="mt-1.5 w-full rounded-md border border-slate-700 bg-slate-900 px-4 py-3 font-mono text-base text-white placeholder:text-slate-600 focus:border-sky-500 focus:outline-none"
        />
        <datalist id="gene-options">
          {genes.map((r) => <option value={r.gene.symbol}>{r.gene.disease}</option>)}
        </datalist>
      </div>

      <div>
        <label for="intent" class="block text-xs font-medium text-slate-500">
          Regulation query
        </label>
        <select
          id="intent"
          name="intent"
          class="mt-1.5 w-full rounded-md border border-slate-700 bg-slate-900 px-4 py-3 text-base text-white focus:border-sky-500 focus:outline-none"
        >
          <option value="up">Upregulate — increase expression</option>
          <option value="down">Downregulate — reduce expression</option>
          <option value="off">Silence — switch off</option>
        </select>
      </div>

      <button
        type="submit"
        class="w-full rounded-md bg-sky-500 px-5 py-3 text-sm font-semibold text-slate-950 transition hover:bg-sky-400"
      >
        Run query
      </button>

      <p id="form-error" class="hidden text-sm text-red-400"></p>
    </form>

    <div class="mt-10 border-t border-slate-800 pt-6">
      <p class="text-xs font-medium text-slate-500">Genes with records available</p>
      <div class="mt-3 flex flex-wrap gap-2">
        {
          genes.map((r) => (
            <a
              href={`${base}/results?gene=${r.gene.symbol}&intent=${r.gene.direction === 'too_much' ? 'down' : 'up'}`}
              class="rounded-full border border-slate-700 px-3 py-1.5 font-mono text-xs text-slate-300 transition hover:border-sky-500/60 hover:text-white"
            >
              {r.gene.symbol}
            </a>
          ))
        }
      </div>
      <p class="mt-3 text-xs text-slate-600">
        Only these genes have records in this build. Anything else returns no result rather
        than a guess.
      </p>
    </div>
  </div>

  <script set:html={`window.__SYMBOLS__ = ${JSON.stringify(genes.map((g) => g.gene.symbol))};`} is:inline />
  <script is:inline>
    (function () {
      const known = window.__SYMBOLS__;
      const form = document.getElementById('query-form');
      const err = document.getElementById('form-error');

      form.addEventListener('submit', (e) => {
        const value = document.getElementById('gene').value.trim().toUpperCase();
        document.getElementById('gene').value = value;
        if (!known.includes(value)) {
          e.preventDefault();
          err.textContent =
            'No record for "' + value + '" in this build. Available: ' + known.join(', ') + '.';
          err.classList.remove('hidden');
        }
      });
    })();
  </script>
</Base>
