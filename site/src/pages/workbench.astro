---
import Layout from "../layouts/Layout.astro";
import type { GeneRecord } from "../lib/records";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const records = Object.values(
  import.meta.glob<GeneRecord>("../../public/data/*.json", {
    eager: true,
    import: "default",
  }),
).sort((a, b) => a.gene.symbol.localeCompare(b.gene.symbol));
const analyses = [...new Set(records.filter((r) => r.analysis).map((r) => r.gene.symbol))].map((symbol) => {
  const runs = records.filter((r) => r.analysis && r.gene.symbol === symbol);
  const record = runs.find((r) => r.analysis!.supported_modes.includes("up")) || runs[0];
  return { symbol, name: runs.map((r) => r.gene.disease).join(" / "), modes: runs.flatMap((r) => r.analysis!.supported_modes), record };
});
const suggestedTargets = ["NF1", "MYC", "LDLR"].flatMap((symbol) =>
  analyses.filter((a) => a.symbol === symbol).map((a) => a.record),
);
---

<Layout title="Workbench — Rewire Bio" page="workbench">
  <div class="workbench-shell page-shell">
    <div class="workbench-intro">
      <p class="eyebrow">
        <span class="status-dot"></span> Workbench / Human GRCh38
      </p>
      <h1>
        Regulatory
        <br />
        contacts.
      </h1>
      <p class="lead">
        Inspect regulatory elements and candidate enhancer–promoter
        interactions.
      </p>
      <div class="mini-loop" aria-hidden="true">
        <svg viewBox="0 0 440 180" fill="none">
          <path d="M18 135H420" stroke="currentColor" opacity=".2" />
          <path
            d="M78 135C78 -10 345 -10 345 135"
            stroke="var(--accent)"
            stroke-width="2"
          />
          <path
            d="M78 135C78 50 255 50 255 135"
            stroke="var(--accent)"
            stroke-width="1.5"
            stroke-dasharray="4 5"
          />
          <rect x="69" y="126" width="18" height="18" fill="#2A6FA8" />
          <circle cx="255" cy="135" r="6" fill="var(--accent)" />
          <circle cx="345" cy="135" r="6" fill="var(--accent)" />
          <text x="78" y="169" text-anchor="middle">
            PROMOTER
          </text>
          <text x="309" y="169" text-anchor="middle">
            REGULATORY ELEMENTS
          </text>
        </svg>
      </div>
    </div>
    <div class="query-panel">
      <form
        id="query-form"
        action={`${base}/results/`}
        method="get"
        data-symbols={JSON.stringify(records.map((r) => r.gene.symbol))}
        data-analyses={JSON.stringify(
          analyses.map(({symbol, name, modes}) => ({symbol, name, modes})),
        )}
      >
        <label class="field-label" for="gene">
          Target gene
        </label>
        <div class="gene-input-wrap">
          <input
            id="gene"
            name="gene"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="false"
            aria-controls="gene-suggestions"
            placeholder="Gene symbol or name"
            required
            maxlength="60"
            autocomplete="off"
            spellcheck="false"
            aria-describedby="gene-help form-error"
          />
        </div>
        <input id="gene-source" name="source" value="reference" type="hidden" />
        <ul
          id="gene-suggestions"
          class="gene-suggestions"
          role="listbox"
          aria-label="Human gene suggestions"
          hidden
        ></ul>
        <p class="small muted" id="gene-help" aria-live="polite"></p>
        <fieldset class="direction-fieldset">
          <legend class="field-label">Desired regulation</legend>
          <div class="direction-options">
            <label>
              <input type="radio" name="intent" value="up" checked />
              <span>
                <b aria-hidden="true">↑</b>Upregulate
              </span>
            </label>
            <label>
              <input type="radio" name="intent" value="down" />
              <span>
                <b aria-hidden="true">↓</b>Downregulate
              </span>
            </label>
          </div>
        </fieldset>
        <p class="form-error" id="form-error" role="alert" hidden></p>
        <button class="button dark submit-button" type="submit">
          Explore <span aria-hidden="true">→</span>
        </button>
      </form>
      <div class="example-picker">
        <span class="eyebrow">Suggested targets</span>
        <div class="example-buttons">
          {suggestedTargets.map((r) => (
              <button
                type="button"
                class="example-button"
                data-gene={r.gene.symbol}
                data-source="analysis"
                data-mode={
                  r.gene.direction === "too_much"
                      ? "down"
                      : "up"
                }
              >
                <strong>{r.gene.symbol}</strong>
                <span>
                  {r.analysis!.source.n_meeting_dose_goal}{" "}
                  {r.analysis!.source.n_meeting_dose_goal === 1
                    ? "design"
                    : "designs"}
                </span>
              </button>
            ))}
        </div>
      </div>
    </div>
  </div>
  <script src="../scripts/workbench.ts"></script>
</Layout>
